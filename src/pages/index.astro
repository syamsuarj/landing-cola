---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Apresiasi from '../components/Apresiasi.astro';
import Tentang from '../components/Tentang.astro';
import FilosofiLogo from '../components/FilosofiLogo.astro';
import Milestones from '../components/Milestones.astro';
import VisiMisi from '../components/VisiMisi.astro';
import Kepemimpinan from '../components/Kepemimpinan.astro';
import Bisnis from '../components/Bisnis.astro';
import Angka from '../components/Angka.astro';
import Kemitraan from '../components/Kemitraan.astro';
import Karir from '../components/Karir.astro';
import Berita from '../components/Berita.astro';
import Keterbukaan from '../components/Keterbukaan.astro';
import Footer from '../components/Footer.astro';
---
<Layout
  title="PT Agrinas Palma Nusantara (Persero) — Energi Hijau, Masa Depan Berkelanjutan"
  description="PT Agrinas Palma Nusantara (Persero) berkomitmen mewujudkan kemandirian energi terbarukan nasional melalui pengelolaan perkebunan kelapa sawit yang berkelanjutan dan strategis."
>
  <Header />
  <main id="utama">
    <Hero />
    <Apresiasi />
    <Tentang />
    <FilosofiLogo />
    <Milestones />
    <VisiMisi />
    <Kepemimpinan />
    <Bisnis />
    <Angka />
    <Kemitraan />
    <Karir />
    <Berita />
    <Keterbukaan />
  </main>
  <Footer />
  <script>
    import '../scripts/animations';
  </script>
</Layout>
