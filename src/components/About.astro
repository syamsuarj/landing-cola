---
import { Image } from 'astro:assets';
import fotoApotek from '../assets/photos/sejarah-apotek.jpg';

// Koreksi fakta sesuai QA-T4B.md (#1 1894/1899, #2 tanpa/rendah kalori, #7 Zero Sugar 2017)
const events = [
  { y: '1886', k: 'Lahir di Atlanta', t: 'Apoteker John Pemberton meracik sirup Coca-Cola di Atlanta, Georgia, dan menjualnya sebagai minuman tonik di apotek.' },
  { y: '1888', k: 'Era Candler', t: 'Asa Candler mulai mengambil alih hak atas minuman ini dan di tahun-tahun berikutnya mengembangkan pemasarannya secara luas.' },
  { y: '1892', k: 'Perusahaan berdiri', t: 'Candler mendirikan The Coca-Cola Company di Georgia.' },
  { y: '1894', k: 'Botol pertama', t: 'Joseph Biedenharn di Vicksburg, Mississippi, pertama kali membotolkan Coca-Cola, sehingga bisa dinikmati di luar kedai minuman. Pembotolan berskala luas dimulai pada 1899.' },
  { y: '1915', k: 'Botol kontur', t: 'Desain botol kontur dibuat oleh Root Glass Company agar mudah dikenali, bahkan dalam gelap atau saat pecah.' },
  { y: '1928', k: 'Olimpiade', t: 'Coca-Cola menjadi sponsor Olimpiade Amsterdam, awal kemitraan panjang dengan ajang olahraga dunia.' },
  { y: '1971', k: 'Iklan legendaris', t: 'Iklan "I\'d Like to Buy the World a Coke" ditayangkan dan menjadi salah satu iklan paling diingat.' },
  { y: '1982', k: 'Diet Coke', t: 'Diet Coke diperkenalkan sebagai varian tanpa/rendah kalori.' },
  { y: '1985', k: 'New Coke', t: 'Formula baru ("New Coke") diluncurkan lalu rasa klasik kembali sebagai Coca-Cola Classic setelah banyak penggemar bereaksi.' },
  { y: '2005', k: 'Tanpa gula', t: 'Coca-Cola Zero, varian tanpa gula, diluncurkan di Amerika Serikat, kemudian dipasarkan di banyak negara dan menjadi Coca-Cola Zero Sugar pada 2017.' },
];
const pad = (n: number) => String(n).padStart(2, '0');
---
<section id="sejarah" class="sj grain" aria-labelledby="judul-sejarah">
  <div class="container sj-intro">
    <div class="sj-copy">
      <p class="eyebrow" data-sj-reveal>01 · Tentang &amp; Sejarah</p>
      <h2 id="judul-sejarah" class="display-l sj-title" data-sj-reveal>
        <span class="sr-only">Tentang &amp; Sejarah: </span>Dari apotek <span class="serif">ke</span> <span class="text-red">dunia</span>
      </h2>
      <p class="lead sj-lead" data-sj-reveal>Coca-Cola pertama kali diracik pada tahun <strong>1886</strong> di <strong>Atlanta, Georgia</strong>, Amerika Serikat, oleh apoteker <strong>John Pemberton</strong>. Awalnya dijual sebagai minuman tonik di apotek, dan sejak itu berkembang menjadi salah satu merek minuman paling dikenal di dunia. Berikut tonggak-tonggak penting perjalanannya.</p>
    </div>
    <figure class="sj-photo" data-sj-photo>
      <div class="sj-photo-frame">
        <Image src={fotoApotek} alt="Deretan botol kaca apotek kuno bertutup kaca di atas rak kayu" widths={[480, 760, 1100]} sizes="(min-width: 900px) 40vw, 100vw" loading="lazy" />
      </div>
      <figcaption>Suasana apotek lama — foto ilustrasi, bukan apotek tahun 1886.</figcaption>
    </figure>
  </div>

  <div class="sj-pin" data-sj-pin>
    <div class="container sj-bar">
      <p class="eyebrow sj-bar-label" aria-hidden="true">Tonggak sejarah · 1886 — 2005</p>
      <div class="sj-progress" aria-hidden="true"><span data-sj-progress></span></div>
    </div>
    <div class="sj-viewport" data-sj-viewport>
      <ol class="sj-track" data-sj-track aria-label="Garis waktu sejarah Coca-Cola">
        {events.map((e, i) => (
          <li class:list={['sj-item', { 'is-key': e.y === '1886' || e.y === '1915' }]} data-sj-item>
            <span class="sj-idx" aria-hidden="true">{pad(i + 1)} / {pad(events.length)}</span>
            <time class="sj-year" datetime={e.y}>{e.y}</time>
            <div class="sj-text">
              <h3 class="sj-k">{e.k}</h3>
              <p>{e.t}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .sj {
    background:
      radial-gradient(60% 45% at 88% 6%, rgba(142, 0, 16, .38), transparent 70%),
      var(--c-ink);
    padding-block: clamp(88px, 12vw, 168px) clamp(56px, 8vw, 120px);
    overflow-x: clip;
  }
  .sj > * { position: relative; z-index: 2; }

  /* ---------- Intro split ---------- */
  .sj-intro { display: grid; gap: clamp(32px, 5vw, 72px); align-items: end; }
  .sj-title { margin: .15em 0 .4em; }
  .sj-title .serif { font-size: .78em; color: var(--c-cream); }
  .sj-lead { color: var(--c-muted); max-width: 38rem; margin: 0; }
  .sj-lead strong { color: var(--c-cream); font-weight: 700; }
  .sj-photo { margin: 0; }
  .sj-photo-frame { overflow: hidden; border-radius: var(--radius); }
  .sj-photo :global(img) {
    width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover;
    filter: saturate(.8) contrast(1.05);
  }
  .sj-photo figcaption { margin-top: .75rem; font-size: .8rem; color: var(--c-muted); }
  @media (min-width: 900px) {
    .sj-intro { grid-template-columns: 1.3fr 1fr; }
    .sj-photo :global(img) { aspect-ratio: 1 / 1; }
  }

  /* ---------- Bar progres ---------- */
  .sj-pin { margin-top: clamp(64px, 9vw, 128px); }
  .sj-bar { display: flex; align-items: center; gap: 1.25rem; }
  .sj-bar-label { margin: 0; white-space: nowrap; }
  .sj-progress { flex: 1; min-width: 40px; height: 2px; background: var(--c-line); border-radius: 2px; overflow: hidden; }
  .sj-progress span { display: block; height: 100%; width: 100%; background: var(--c-red); transform-origin: left center; }

  /* ---------- Default (tanpa JS / reduced-motion / < 768px): daftar vertikal ---------- */
  .sj-viewport { width: 100%; max-width: var(--container); margin-inline: auto; padding-inline: var(--gutter); }
  .sj-track { list-style: none; margin: 0; padding: 0; }
  .sj-item {
    display: grid; grid-template-columns: minmax(0, 1fr); gap: .25rem 2.5rem;
    padding: clamp(28px, 4vw, 44px) 0;
    border-bottom: 1px solid var(--c-line);
  }
  .sj-idx { font-size: .75rem; letter-spacing: .2em; color: var(--c-muted); font-weight: 700; }
  .sj-year {
    display: block;
    font-family: var(--font-display); font-weight: 400;
    font-size: clamp(4.5rem, 22vw, 9rem); line-height: .85; letter-spacing: -.01em;
    color: transparent; -webkit-text-stroke: 1.5px rgba(245, 239, 230, .6);
  }
  .is-key .sj-year { color: var(--c-red); -webkit-text-stroke: 0; }
  .sj-k { font-family: var(--font-body); font-weight: 800; font-size: clamp(1.15rem, 1rem + .6vw, 1.5rem); line-height: 1.2; margin: .5rem 0 .4rem; color: var(--c-cream); }
  .sj-text p { color: var(--c-muted); margin: 0; max-width: 34rem; }
  @media (min-width: 640px) {
    .sj-item { grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); align-items: end; }
    .sj-idx { grid-column: 1 / -1; }
  }

  /* ---------- Horizontal ter-pin (class .is-h dipasang JS, hanya >= 768px & tanpa reduced-motion) ---------- */
  .sj.is-h .sj-pin {
    height: 100vh; height: 100svh;
    margin-top: clamp(24px, 4vw, 56px);
    display: flex; flex-direction: column; justify-content: center; gap: clamp(28px, 6vh, 64px);
    padding-top: var(--header-h);
  }
  .sj.is-h .sj-viewport { max-width: none; padding: 0; overflow: hidden; }
  .sj.is-h .sj-track {
    display: flex; flex-wrap: nowrap; width: max-content;
    padding-inline: max(var(--gutter), calc((100vw - var(--container)) / 2 + var(--gutter)));
    gap: clamp(28px, 3.5vw, 56px);
  }
  .sj.is-h .sj-item {
    width: clamp(320px, 36vw, 500px);
    grid-template-columns: minmax(0, 1fr); align-content: start; align-items: start;
    border-bottom: 0; border-top: 1px solid var(--c-line);
    padding: 1.25rem 0 0;
  }
  .sj.is-h .sj-year { font-size: clamp(7rem, 13.5vw, 13rem); margin: .12em 0 .08em; }
  .sj.is-h .sj-text { max-width: 30rem; }
</style>

<script>
  import '../scripts/sections/about';
</script>
