---
import HeroBackdrop from './HeroBackdrop.astro';

// Berita terbaru (judul dari beranda & /news resmi, diambil 2026-10-06)
const newsTitle = 'Dukung E20, Agrinas Palma dan IPB University Kembangkan Bioetanol Multifeedstock';
// encodeURI (bukan encodeURIComponent): koma harus tetap ',' — '%2C' membuka halaman "Berita Tidak Ditemukan" (K1)
const newsHref = 'https://agrinaspalma.co.id/news/' + encodeURI(newsTitle);
---
<section class="hero grain" id="beranda" aria-labelledby="judul-hero">
  <div class="scene" data-hero-scene>
    <!-- T11: latar studio gelap + kontur topografi + foto blur tipis; [data-hero-bg] ada di dalamnya -->
    <HeroBackdrop />

    <!-- BABAK 1: langsung terlihat saat load -->
    <div class="act act-1" data-act="1">
      <div class="act1-main">
        <p class="eyebrow kicker">Energi Hijau, Masa Depan Berkelanjutan</p>
        <h1 id="judul-hero" class="title">
          <span class="line">Mengelola</span>
          <span class="line">Energi Hijau</span>
          <span class="line accent">Nusantara</span>
        </h1>
        <p class="lead">PT Agrinas Palma Nusantara (Persero) berkomitmen mewujudkan kemandirian energi terbarukan nasional melalui pengelolaan perkebunan kelapa sawit yang berkelanjutan dan strategis.</p>
        <p class="ctas">
          <a class="btn btn-light" href="#tentang">Tentang Agrinas <span aria-hidden="true">↗</span></a>
          <a class="btn-ghost" href="#bisnis">Lini Bisnis <span aria-hidden="true">↘</span></a>
        </p>
      </div>
      <a class="news" href={newsHref} target="_blank" rel="noopener">
        <span class="news-tag"><span class="dot" aria-hidden="true"></span>Kabar terbaru</span>
        <span class="news-title">{newsTitle}</span>
        <span class="sr-only">(buka di situs resmi, tab baru)</span>
        <span class="news-arrow" aria-hidden="true">→</span>
      </a>
    </div>

    <!-- Objek utama: fallback SVG = ilustrasi diorama kebun sawit: pulau melayang membulat (atas rumput, sisi laterit,
         bawah meruncing gelap), 3 sawit belakang + 2 depan dengan jalan panen di tengah, TBS = gerombol butir lonjong (selaras Three.js).
         Tampil tanpa WebGL / reduced-motion / sebelum kanvas siap; diganti canvas Three.js (#hero-3d) bila tersedia.
         Sumber: qa/out-t7c/gen-svg.py (T7c, revisi T9c). id gradient/symbol berawalan agd- agar tak bentrok. -->
    <div class="object" id="hero-art" data-hero-object>
      <div class="fallback">
        <svg viewBox="24 50 352 306" role="img" aria-label="Ilustrasi diorama kebun kelapa sawit: pulau tanah melayang dengan barisan pohon sawit berbuah dan tandan buah segar hasil panen di tepi jalan"><defs><linearGradient id="agd-grass" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#4e8a3d"/><stop offset="1" stop-color="#2a5429"/></linearGradient><linearGradient id="agd-soil" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#9a5a3e"/><stop offset=".55" stop-color="#874632"/><stop offset="1" stop-color="#5e2f22"/></linearGradient><linearGradient id="agd-rock" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#5a3022"/><stop offset=".6" stop-color="#36201a"/><stop offset="1" stop-color="#1c1210"/></linearGradient><radialGradient id="agd-shd"><stop offset="0" stop-color="#000" stop-opacity=".38"/><stop offset="1" stop-color="#000" stop-opacity="0"/></radialGradient><clipPath id="agd-clip"><path d="M367.6 172C368.8 180.9 360.7 191.3 351.3 199.4C342 207.6 326.6 214.6 311.5 220.8C296.4 226.9 279.3 232.9 260.7 236.2C242.2 239.4 220.2 240.2 200 240.1C179.8 240.1 159.4 238.5 139.5 235.9C119.7 233.2 96.1 230.2 80.9 224.1C65.7 218 53.9 208.2 48.4 199.5C42.8 190.8 46.4 180.9 47.6 172C48.8 163.1 49.4 154.2 55.7 145.8C62 137.5 71.4 128.3 85.2 121.8C99 115.3 119.1 110.4 138.3 106.8C157.4 103.2 179.4 100.2 200 100.1C220.6 100.1 244.1 102.4 262 106.5C279.9 110.7 293.5 118.5 307.2 125.1C320.9 131.7 334 138.1 344 145.9C354.1 153.7 366.4 163.1 367.6 172Z"/></clipPath><linearGradient id="agd-trunk" x1="0" x2="1"><stop offset="0" stop-color="#6b4a2a"/><stop offset=".55" stop-color="#4a3219"/><stop offset="1" stop-color="#2a1b0e"/></linearGradient><symbol id="agd-fr" overflow="visible"><path d="M0 0Q22 -21 56 9" stroke-width="1.8"/><path d="M5.5 -4.3l0.2 -8.4M5.5 -4.3l6.4 5.4M8.6 -6l7.3 -6.6M8.6 -6l5.4 8.2M11.8 -7.3l8.3 -7M11.8 -7.3l7 8.3M15.1 -8.2l10.9 -3.7M15.1 -8.2l4.8 10.5M18.5 -8.6l11.6 -2.7M18.5 -8.6l6 10.3M22.1 -8.6l12 -0.4M22.1 -8.6l3.4 11.5M25.7 -8.1l