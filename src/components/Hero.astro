---
import { Image } from 'astro:assets';
import bg from '../assets/agrinas/hero-sawit1.webp';

// Berita terbaru (judul dari beranda & /news resmi, diambil 2026-10-06)
const newsTitle = 'Dukung E20, Agrinas Palma dan IPB University Kembangkan Bioetanol Multifeedstock';
const newsHref = 'https://agrinaspalma.co.id/news/' + encodeURIComponent(newsTitle);
---
<section class="hero grain" id="beranda" aria-labelledby="judul-hero">
  <div class="scene" data-hero-scene>
    <div class="bg" aria-hidden="true">
      <Image src={bg} alt="" widths={[640, 1024, 1720]} sizes="100vw" quality={60} loading="eager" class="bg-img" data-hero-bg />
    </div>
    <div class="shade" aria-hidden="true"></div>
    <div class="glow" aria-hidden="true"></div>

    <!-- BABAK 1: langsung terlihat saat load -->
    <div class="act act-1" data-act="1">
      <div class="act1-main">
        <p class="eyebrow kicker">Energi Hijau, Masa Depan Berkelanjutan</p>
        <h1 id="judul-hero" class="title">
          <span class="line">Mengelola</span>
          <span class="line">Energi Hijau</span>
          <span class="line accent">Nusantara</span>
        </h1>
        <p class="lead">PT Agrinas Palma Nusantara (Persero) berkomitmen mewujudkan kemandirian energi terbarukan nasional melalui pengelolaan perkebunan kelapa sawit yang berkelanjutan dan strategis.</p>
        <p class="ctas">
          <a class="btn btn-light" href="#tentang">Tentang Agrinas <span aria-hidden="true">↗</span></a>
          <a class="btn-ghost" href="#bisnis">Lini Bisnis <span aria-hidden="true">↘</span></a>
        </p>
      </div>
      <a class="news" href={newsHref} target="_blank" rel="noopener">
        <span class="news-tag"><span class="dot" aria-hidden="true"></span>Kabar terbaru</span>
        <span class="news-title">{newsTitle}</span>
        <span class="sr-only">(buka di situs resmi, tab baru)</span>
        <span class="news-arrow" aria-hidden="true">→</span>
      </a>
    </div>

    <!-- Objek utama: SVG tetes minyak sebagai fallback, diganti canvas Three.js bila tersedia -->
    <div class="object" id="hero-art" data-hero-object>
      <div class="fallback">
        <svg viewBox="0 0 200 260" role="img" aria-label="Ilustrasi tetes minyak sawit keemasan">
          <defs>
            <radialGradient id="drop-g" cx="42%" cy="62%" r="62%">
              <stop offset="0" stop-color="#FFE7A3" />
              <stop offset=".35" stop-color="#F2C230" />
              <stop offset=".75" stop-color="#C77A0C" />
              <stop offset="1" stop-color="#6B3A05" />
            </radialGradient>
            <linearGradient id="drop-h" x1="0" x2="0" y1="0" y2="1">
              <stop offset="0" stop-color="#fff" stop-opacity=".85" />
              <stop offset="1" stop-color="#fff" stop-opacity="0" />
            </linearGradient>
          </defs>
          <path d="M100 8 C 128 70 178 118 178 168 a78 78 0 0 1 -156 0 C 22 118 72 70 100 8 Z" fill="url(#drop-g)" />
          <path d="M70 120 c -14 22 -20 40 -18 62" stroke="url(#drop-h)" stroke-width="9" stroke-linecap="round" fill="none" />
        </svg>
      </div>
      <div id="hero-3d" class="stage" aria-hidden="true"></div>
    </div>

    <!-- BABAK 2 -->
    <div class="act act-2" data-act="2">
      <p class="eyebrow"><span class="num">02</span> Mandat Swasembada Nasional</p>
      <h2 class="display-l">Energi hijau untuk <span class="accent">negeri.</span></h2>
      <p class="body">PT Agrinas Palma Nusantara (Persero) hadir untuk negeri atas mandat Presiden Republik Indonesia, Bapak Prabowo Subianto, dalam mewujudkan Asta Cita swasembada energi nasional.</p>
    </div>

    <!-- BABAK 3 -->
    <div class="act act-3" data-act="3">
      <p class="eyebrow"><span class="num">03</span> Semangat Patriot</p>
      <h2 class="display-l">Patriot&nbsp;· Loyal&nbsp;· <span class="accent">Profesional</span></h2>
      <p class="body">Kemakmuran bumi Nusantara, semangat patriot, loyalitas kepada nusa, dan dedikasi profesional dalam setiap langkah bisnis.</p>
      <p class="ctas"><a class="btn" href="#tentang">Tentang Agrinas</a><a class="btn-ghost" href="#bisnis">Lini Bisnis</a></p>
    </div>

    <div class="progress" aria-hidden="true">
      <span class="p-num"><b data-hero-step>01</b> / 03</span>
      <span class="p-bars"><i data-bar="1"></i><i data-bar="2"></i><i data-bar="3"></i></span>
    </div>
    <p class="scroll-cue" aria-hidden="true">Gulir</p>
  </div>
  <span class="logo-stripe hero-stripe" aria-hidden="true"></span>
</section>

<style>
  .hero { background: var(--c-ink); color: var(--c-cream); }
  .scene {
    position: relative;
    min-height: 100svh;
    padding: calc(var(--header-h) + 2.5rem) var(--gutter) 3rem;
  }
  .bg { position: absolute; inset: 0; z-index: 0; overflow: hidden; }
  .bg :global(.bg-img) { width: 100%; height: 100%; object-fit: cover; object-position: 60% 50%; transform-origin: 60% 50%; }
  .shade {
    position: absolute; inset: 0; z-index: 0; pointer-events: none;
    background:
      linear-gradient(90deg, rgba(7, 21, 14, .94) 0%, rgba(7, 21, 14, .78) 38%, rgba(7, 21, 14, .45) 70%, rgba(7, 21, 14, .6) 100%),
      linear-gradient(180deg, rgba(7, 21, 14, .55) 0%, rgba(7, 21, 14, 0) 30%, rgba(7, 21, 14, .25) 70%, var(--c-ink) 100%);
  }
  .glow {
    position: absolute; z-index: 0; pointer-events: none;
    right: 6vw; top: 50%; width: min(820px, 120vw); aspect-ratio: 1; translate: 25% -50%;
    background: radial-gradient(closest-side, rgba(242, 194, 48, .22), rgba(26, 127, 55, .14) 50%, rgba(7, 21, 14, 0) 72%);
  }
  .container-w { max-width: var(--container); margin-inline: auto; }

  /* ---------- Babak 1 ---------- */
  .act-1 {
    position: relative; z-index: 3; max-width: var(--container); margin-inline: auto;
    min-height: calc(100svh - var(--header-h) - 5.5rem);
    display: flex; flex-direction: column; justify-content: space-between; gap: 2.5rem;
  }
  .act1-main { max-width: 46rem; padding-top: clamp(.5rem, 4svh, 4rem); }
  .kicker { margin-bottom: 1.4rem; }
  .title {
    font-family: var(--font-display); font-weight: 500; letter-spacing: -.025em;
    font-size: clamp(3rem, min(8vw, 11svh), 7.25rem); line-height: .98; margin: 0;
    display: flex; flex-direction: column;
  }
  .title .accent { font-weight: 500; padding-right: .08em; }
  .lead { max-width: 40rem; margin: 1.4rem 0 0; color: rgba(244, 245, 240, .88); }
  .ctas { display: flex; flex-wrap: wrap; gap: .8rem; margin: 2rem 0 0; }
  .btn-light { background: var(--c-cream); border-color: var(--c-cream); color: var(--c-ink); }
  .btn-light:hover { background: var(--c-mint); border-color: var(--c-mint); color: var(--c-ink); }

  .news {
    display: flex; align-items: center; gap: 1rem; min-height: 56px; max-width: 100%;
    padding: .9rem 0; border-top: 1px solid var(--c-line); text-decoration: none; color: var(--c-cream);
  }
  .news-tag {
    display: inline-flex; align-items: center; gap: .55rem; flex: none;
    font-size: .72rem; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; color: var(--c-mint);
    padding-right: 1rem; border-right: 1px solid var(--c-line);
  }
  .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--c-mint); box-shadow: 0 0 0 4px rgba(161, 219, 179, .18); }
  .news-title { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: .95rem; }
  .news-arrow { margin-left: auto; flex: none; width: 36px; height: 36px; border-radius: 50%; border: 1px solid var(--c-line); display: grid; place-items: center; transition: background-color .3s var(--ease), color .3s var(--ease); }
  .news:hover .news-arrow, .news:focus-visible .news-arrow { background: var(--c-mint); color: var(--c-ink); }
  .news:hover .news-title { text-decoration: underline; text-underline-offset: 3px; }

  /* ---------- Objek ---------- */
  .object {
    position: absolute; z-index: 2; left: 72%; top: 50svh;
    width: min(42vw, 560px); height: min(78svh, 700px); translate: -50% -50%;
    pointer-events: none;
  }
  .fallback { position: absolute; inset: 0; display: grid; place-items: center; }
  .fallback svg { height: 62%; width: auto; filter: drop-shadow(0 30px 50px rgba(0, 0, 0, .55)) drop-shadow(0 0 40px rgba(242, 194, 48, .3)); }
  .stage { position: absolute; inset: 0; display: none; }
  .stage :global(canvas) { width: 100% !important; height: 100% !important; display: block; }
  .object:global(.is-3d) .stage { display: block; }
  .object:global(.is-3d) .fallback { display: none; }

  /* ---------- Babak 2 & 3: tampilan statis (tanpa JS / reduced-motion) ---------- */
  .act-2, .act-3 {
    position: relative; z-index: 3; max-width: var(--container); margin-inline: auto;
    padding: 5rem 0; border-top: 1px solid var(--c-line);
  }
  .act-2 > *, .act-3 > * { max-width: 40rem; }
  .act h2 { font-size: clamp(2.4rem, 5.4vw, 5.25rem); }
  .act .body { color: rgba(244, 245, 240, .88); font-size: clamp(1.02rem, .95rem + .35vw, 1.22rem); margin-top: 1.4rem; }
  .num { color: var(--c-yellow); margin-right: .6rem; }
  /* judul babak 3: patah baris disengaja sebelum aksen agar tidak wrap acak */
  .act-3 h2 .accent { display: block; }
  .progress, .scroll-cue { display: none; }
  .hero-stripe { position: relative; z-index: 3; }

  /* ---------- Mode sinematik (JS + motion): adegan ter-pin ---------- */
  :global(html.motion) .scene { height: 100svh; min-height: 600px; padding: 0; overflow: hidden; }
  :global(html.motion) .act-1 {
    position: absolute; inset: calc(var(--header-h) + 1.5rem) var(--gutter) 1.25rem; min-height: 0; margin: 0;
    max-width: none;
  }
  :global(html.motion) .act-1 > * { width: 100%; max-width: var(--container); margin-inline: auto; }
  :global(html.motion) .act1-main > * { max-width: 46rem; }
  :global(html.motion) .act1-main .lead { max-width: 40rem; }
  :global(html.motion) .act-2, :global(html.motion) .act-3 {
    position: absolute; top: 50%; translate: 0 -50%; padding: 0; border: 0; margin: 0;
    width: min(46vw, 620px); opacity: 0; visibility: hidden;
  }
  :global(html.motion) .act-2 { right: max(var(--gutter), calc((100vw - var(--container)) / 2 + var(--gutter))); }
  :global(html.motion) .act-3 { left: max(var(--gutter), calc((100vw - var(--container)) / 2 + var(--gutter))); }
  :global(html.motion) .progress {
    display: flex; position: absolute; z-index: 4; right: var(--gutter); top: calc(var(--header-h) + 1.4rem);
    align-items: center; gap: .9rem; font-size: .75rem; letter-spacing: .14em; color: var(--c-muted); font-variant-numeric: tabular-nums;
  }
  .p-num b { color: var(--c-cream); font-weight: 700; }
  .p-bars { display: flex; gap: 4px; }
  .p-bars i { width: 22px; height: 2px; background: var(--c-line); transition: background-color .3s; }
  .p-bars i:global(.on) { background: var(--c-mint); }
  :global(html.motion) .scroll-cue {
    display: block; position: absolute; z-index: 4; right: var(--gutter); bottom: 6.5rem; margin: 0;
    font-size: .68rem; letter-spacing: .3em; text-transform: uppercase; color: var(--c-muted);
    writing-mode: vertical-rl;
  }
  :global(html.motion) .scroll-cue::after {
    content: ""; display: block; width: 1px; height: 30px; margin: .6rem auto 0; background: linear-gradient(var(--c-cream), transparent);
    animation: cue 1.8s var(--ease) infinite;
  }
  @keyframes cue { 0% { transform: scaleY(0); transform-origin: top; } 50% { transform: scaleY(1); transform-origin: top; } 51% { transform-origin: bottom; } 100% { transform: scaleY(0); transform-origin: bottom; } }
  @media (max-width: 1199px) { :global(html.motion) .scroll-cue { display: none; } }

  /* ---------- Tablet/Mobile ---------- */
  @media (max-width: 1023px) {
    .object { left: 78%; width: 46vw; opacity: .9; }
    .shade { background:
      linear-gradient(90deg, rgba(7, 21, 14, .92) 0%, rgba(7, 21, 14, .7) 60%, rgba(7, 21, 14, .55) 100%),
      linear-gradient(180deg, rgba(7, 21, 14, .5) 0%, rgba(7, 21, 14, .1) 30%, rgba(7, 21, 14, .3) 70%, var(--c-ink) 100%); }
  }
  @media (max-width: 760px) {
    .object { left: auto; right: 0; top: calc(66svh - 7.5rem); translate: 0 0; width: 56vw; height: 34svh; opacity: .75; }
    .glow { right: -20vw; top: 70%; }
    .act1-main { padding-top: .5rem; }
    .kicker { font-size: .66rem; letter-spacing: .16em; margin-bottom: 1rem; }
    .title { font-size: clamp(2.6rem, 12.4vw, 4rem); }
    .lead { font-size: 1rem; margin-top: 1.1rem; }
    .ctas { margin-top: 1.4rem; gap: .6rem; }
    .ctas a { padding-inline: 1.15rem; }
    .news { gap: .7rem; }
    .news-tag { font-size: .64rem; letter-spacing: .14em; padding-right: .7rem; }
    .news-title { font-size: .85rem; }
    .news-arrow { display: none; }
    .act-2, .act-3 { padding: 3.5rem 0; }

    :global(html.motion) .act-1 { inset: calc(var(--header-h) + .5rem) var(--gutter) 2.6rem; gap: 1rem; }
    :global(html.motion) .act-2, :global(html.motion) .act-3 {
      top: auto; bottom: 3.5rem; translate: 0 0; left: var(--gutter); right: var(--gutter); width: auto;
    }
    :global(html.motion) .act-2 .body, :global(html.motion) .act-3 .body { font-size: 1rem; margin-top: .9rem; }
    :global(html.motion) .act-3 .ctas { margin-top: 1.2rem; }
    :global(html.motion) .progress { top: auto; bottom: 1.1rem; right: var(--gutter); }
  }
  @media (max-width: 760px) and (max-height: 700px) {
    .title { font-size: clamp(2.3rem, 11vw, 3.2rem); }
    :global(html.motion) .act-2 .body, :global(html.motion) .act-3 .body { font-size: .95rem; }
  }
</style>
