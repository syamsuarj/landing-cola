---
import Bottle from './Bottle.astro';
---
<section class="hero grain" id="hero" aria-labelledby="judul-hero">
  <div class="scene" data-hero-scene>
    <div class="glow" aria-hidden="true"></div>
    <div class="floor" aria-hidden="true"></div>

    <!-- BABAK 1: judul raksasa di belakang objek; langsung terlihat saat load -->
    <div class="act act-1" data-act="1">
      <p class="eyebrow kicker"><span class="dot" aria-hidden="true"></span>Sejak 1886 · Atlanta</p>
      <h1 id="judul-hero" class="title">
        <span class="t-sm serif">Rasa yang</span>
        <span class="t-xl">Dikenal</span>
        <span class="t-md"><span>di Seluruh</span> <span>Dunia</span></span>
      </h1>
      <div class="act1-foot">
        <p class="lead">Kenali Coca-Cola: minuman bersoda legendaris yang lahir di Atlanta dan kini dinikmati di lebih dari 200 negara dan wilayah.</p>
        <a class="btn" href="#produk">Lihat Produk</a>
      </div>
    </div>

    <!-- Objek utama: SVG sebagai fallback, diganti canvas Three.js bila tersedia -->
    <div class="object" id="hero-art" data-hero-object>
      <div class="fallback"><Bottle label="Ilustrasi botol minuman bersoda (gambar buatan sendiri, bukan produk resmi)" color="#F40009" /></div>
      <div id="hero-3d" class="stage" aria-hidden="true"></div>
    </div>

    <!-- BABAK 2 -->
    <div class="act act-2" data-act="2">
      <p class="eyebrow"><span class="num">02</span> Asal-usul</p>
      <h2 class="display-l">Lahir di <span class="text-red">Atlanta</span></h2>
      <p class="body">Diracik pertama kali pada <strong>1886</strong> oleh apoteker <strong>John Pemberton</strong> di Atlanta, Georgia, Amerika Serikat, dan awalnya dijual sebagai minuman tonik di apotek.</p>
    </div>

    <!-- BABAK 3 -->
    <div class="act act-3" data-act="3">
      <p class="eyebrow"><span class="num">03</span> Kini</p>
      <h2 class="display-l"><span class="text-red">200+</span> negara <span class="serif amp">&amp;</span> wilayah</h2>
      <p class="body">Dari satu apotek menjadi salah satu merek minuman paling dikenal di dunia. Ketersediaan varian bisa berbeda di tiap negara.</p>
      <p class="ctas"><a class="btn" href="#produk">Lihat Produk</a><a class="btn-ghost" href="#sejarah">Telusuri Sejarah</a></p>
    </div>

    <div class="progress" aria-hidden="true">
      <span class="p-num"><b data-hero-step>01</b> / 03</span>
      <span class="p-bars"><i data-bar="1"></i><i data-bar="2"></i><i data-bar="3"></i></span>
    </div>
    <p class="scroll-cue" aria-hidden="true">Gulir</p>
  </div>
</section>

<style>
  .hero { background: var(--c-ink); color: var(--c-cream); }
  .scene {
    position: relative;
    min-height: 100svh;
    padding: calc(var(--header-h) + 2rem) var(--gutter) 3rem;
    max-width: 1600px; margin-inline: auto;
  }
  .glow {
    position: absolute; left: 50%; top: 48svh; width: min(1100px, 140vw); aspect-ratio: 1; translate: -50% -50%;
    background: radial-gradient(closest-side, rgba(244, 0, 9, .42), rgba(142, 0, 16, .28) 45%, rgba(10, 10, 11, 0) 72%);
    pointer-events: none; z-index: 0;
  }
  .floor {
    position: absolute; left: 50%; top: calc(91svh - 60px); width: min(560px, 80vw); height: 60px; translate: -50% 0;
    background: radial-gradient(closest-side, rgba(0, 0, 0, .85), transparent);
    z-index: 0; pointer-events: none;
  }

  /* ---------- Babak 1 ---------- */
  .act-1 { position: relative; z-index: 1; min-height: calc(100svh - var(--header-h) - 5rem); display: grid; grid-template-rows: auto 1fr auto; }
  .kicker { display: inline-flex; align-items: center; gap: .6rem; color: var(--c-cream); }
  .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--c-red); }
  .title {
    align-self: center; justify-self: center; text-align: center; margin: 0;
    display: flex; flex-direction: column; align-items: center; line-height: 1;
  }
  .t-sm { align-self: flex-start; font-size: clamp(1.8rem, 4.4vw, 4.2rem); line-height: 1.15; color: var(--c-cream); margin: 0 0 .1em .1em; }
  .t-xl {
    font-family: var(--font-display); font-weight: 400; text-transform: uppercase;
    font-size: clamp(5.5rem, 23vw, 22rem); line-height: .82; letter-spacing: -.01em;
    color: var(--c-cream);
  }
  .t-md {
    font-family: var(--font-display); font-weight: 400; text-transform: uppercase;
    font-size: clamp(1.6rem, 4.6vw, 4.4rem); letter-spacing: .04em; line-height: 1; margin-top: .25em; color: var(--c-red);
    align-self: stretch; display: flex; justify-content: space-between; gap: 1em;
  }
  .act1-foot { display: flex; align-items: flex-end; justify-content: space-between; gap: 1.5rem 3rem; flex-wrap: wrap; position: relative; z-index: 3; }
  .act1-foot .lead { max-width: 30rem; margin: 0; font-size: clamp(1rem, .95rem + .3vw, 1.2rem); color: var(--c-cream); }

  /* ---------- Objek ---------- */
  .object {
    position: absolute; z-index: 2; left: 50%; top: 50svh;
    width: min(54vh, 70vw); height: min(84vh, 760px); translate: -50% -48%;
    pointer-events: none;
  }
  .fallback { position: absolute; inset: 0; display: grid; place-items: center; }
  .fallback :global(svg) { height: 78%; width: auto; transform: rotate(-6deg); filter: drop-shadow(0 30px 40px rgba(0,0,0,.6)) drop-shadow(0 0 30px rgba(244,0,9,.25)); }
  .stage { position: absolute; inset: 0; display: none; }
  .stage :global(canvas) { width: 100% !important; height: 100% !important; display: block; }
  .object:global(.is-3d) .stage { display: block; }
  .object:global(.is-3d) .fallback { display: none; }

  /* ---------- Babak 2 & 3: tampilan statis (tanpa JS / reduced-motion) ---------- */
  .act-2, .act-3 { position: relative; z-index: 3; max-width: 640px; padding: 5rem 0; border-top: 1px solid var(--c-line); }
  .act-3 { margin-left: auto; }
  .act h2 { font-size: clamp(2.6rem, 6.2vw, 6.25rem); }
  .act .body { color: var(--c-cream); font-size: clamp(1.02rem, .95rem + .35vw, 1.25rem); max-width: 34rem; margin-top: 1.4rem; }
  .act .body strong { color: #fff; }
  .num { color: var(--c-red); margin-right: .6rem; }
  .amp { font-size: .8em; text-transform: none; color: var(--c-cream); }
  .ctas { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 2rem; }
  .progress, .scroll-cue { display: none; }

  /* ---------- Mode sinematik (JS + motion): adegan ter-pin ---------- */
  :global(html.motion) .scene { height: 100svh; min-height: 560px; padding: 0; overflow: hidden; }
  :global(html.motion) .act-1 {
    position: absolute; inset: calc(var(--header-h) + 1.25rem) var(--gutter) 2.25rem; min-height: 0;
  }
  :global(html.motion) .act-2, :global(html.motion) .act-3 {
    position: absolute; top: 50%; translate: 0 -50%; padding: 0; border: 0;
    width: min(44vw, 600px); opacity: 0; visibility: hidden;
  }
  :global(html.motion) .act-2 { left: var(--gutter); }
  :global(html.motion) .act-3 { right: var(--gutter); }
  :global(html.motion) .progress {
    display: flex; position: absolute; z-index: 4; right: var(--gutter); top: calc(var(--header-h) + 1.4rem);
    align-items: center; gap: .9rem; font-size: .75rem; letter-spacing: .14em; color: var(--c-muted); font-variant-numeric: tabular-nums;
  }
  .p-num b { color: var(--c-cream); font-weight: 700; }
  .p-bars { display: flex; gap: 4px; }
  .p-bars i { width: 22px; height: 2px; background: var(--c-line); transition: background-color .3s; }
  .p-bars i:global(.on) { background: var(--c-red); }
  :global(html.motion) .scroll-cue {
    display: block; position: absolute; z-index: 4; left: 50%; bottom: 1rem; translate: -50% 0; margin: 0;
    font-size: .68rem; letter-spacing: .3em; text-transform: uppercase; color: var(--c-muted);
  }
  :global(html.motion) .scroll-cue::after {
    content: ""; display: block; width: 1px; height: 26px; margin: .5rem auto 0; background: linear-gradient(var(--c-cream), transparent);
    animation: cue 1.8s var(--ease) infinite;
  }
  @keyframes cue { 0% { transform: scaleY(0); transform-origin: top; } 50% { transform: scaleY(1); transform-origin: top; } 51% { transform-origin: bottom; } 100% { transform: scaleY(0); transform-origin: bottom; } }

  /* ---------- Mobile ---------- */
  @media (max-width: 760px) {
    .object { width: 70vw; height: 44svh; top: 56svh; }
    .title { align-self: start; margin-top: 3svh; }
    .t-md { justify-content: center; gap: .28em; }
    .act1-foot { flex-direction: column; align-items: flex-start; gap: 1rem; }
    .act1-foot .lead { font-size: 1rem; }
    .act-2, .act-3 { padding: 3.5rem 0; }

    :global(html.motion) .act-1 { inset: calc(var(--header-h) + .75rem) var(--gutter) 1.5rem; }
    :global(html.motion) .act-2, :global(html.motion) .act-3 {
      top: auto; bottom: 2.5rem; translate: 0 0; left: var(--gutter); right: var(--gutter); width: auto;
    }
    :global(html.motion) .act-2 .body, :global(html.motion) .act-3 .body { font-size: 1rem; margin-top: .9rem; }
    :global(html.motion) .act-3 .ctas { margin-top: 1.2rem; flex-wrap: nowrap; gap: .6rem; }
    :global(html.motion) .act-3 .ctas a { padding-inline: 1.1rem; font-size: .88rem; }
    :global(html.motion) .progress { top: auto; bottom: 1.1rem; right: var(--gutter); }
    :global(html.motion) .scroll-cue { display: none; }
    .glow { top: 42svh; }
  }
  @media (max-width: 760px) and (max-height: 700px) {
    :global(html.motion) .act-2 .body, :global(html.motion) .act-3 .body { font-size: .95rem; }
  }
</style>
