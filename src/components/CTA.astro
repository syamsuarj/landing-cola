---
import { Image } from 'astro:assets';
import tuang from '../assets/photos/cta-tuang-cola.jpg';
---
<section id="cta" class="cta" aria-labelledby="judul-cta">
  <div class="container">
    <div class="cta-panel grain">
      <div class="cta-copy" data-cta-reveal>
        <p class="cta-eyebrow">Penutup</p>
        <h2 id="judul-cta" class="display-l cta-title">Siap Menikmati Kesegarannya?</h2>
        <p class="cta-lead">Cari varian favoritmu di toko atau minimarket terdekat dan bagikan momen kebersamaan.</p>
        <a class="cta-btn" href="#produk">Pilih Varian Favoritmu <span aria-hidden="true">→</span></a>

        <form class="news" id="news-form" novalidate>
          <h3 class="news-h">Buletin demo</h3>
          <p class="news-note">Formulir ini hanya contoh tampilan statis. Tidak ada data yang dikirim atau disimpan.</p>
          <div class="news-row">
            <label for="email" class="sr-only">Alamat email</label>
            <input id="email" name="email" type="email" placeholder="nama@contoh.com" autocomplete="email" required aria-describedby="news-msg" />
            <button type="submit" class="news-btn">Berlangganan</button>
          </div>
          <p id="news-msg" role="status" aria-live="polite" class="news-msg"></p>
        </form>
      </div>

      <figure class="cta-art">
        <Image
          src={tuang}
          alt="Minuman cola dituang ke gelas dengan latar gelap"
          widths={[400, 640, 900, 1200]}
          sizes="(min-width: 960px) 40vw, 100vw"
          quality={70}
          loading="lazy"
          decoding="async"
          data-cta-img
        />
        <figcaption>Foto: Brandee Taylor / Unsplash</figcaption>
      </figure>
    </div>
  </div>
</section>

<script>
  import '../scripts/sections/cta';
</script>

<style>
  .cta {
    position: relative;
    overflow-x: clip;
    background: var(--c-ink);
    color: #fff;
    padding: clamp(64px, 10vw, 140px) 0;
  }
  .cta-panel {
    position: relative;
    display: grid; grid-template-columns: minmax(0, 1fr);
    border-radius: calc(var(--radius) * 1.5);
    overflow: hidden;
    /* #D6000A dipakai untuk latar teks: putih 5.4:1 (AA). Rona gelap di tepi untuk kedalaman. */
    background:
      radial-gradient(90% 80% at 0% 100%, rgba(142,0,16,.55), transparent 60%),
      #D6000A;
  }
  .cta-copy { position: relative; z-index: 2; padding: clamp(32px, 6vw, 80px); }
  .cta-eyebrow {
    margin: 0 0 1.25rem;
    font-size: .78rem; font-weight: 700; letter-spacing: .22em; text-transform: uppercase;
    color: #fff;
  }
  .cta-title { color: #fff; max-width: 11ch; margin-bottom: 1.5rem; font-size: clamp(2.6rem, 11.5vw, 4.5rem); }
  @media (min-width: 960px) { .cta-title { font-size: clamp(4rem, 5.6vw, 6rem); } }
  .cta-lead { font-size: clamp(1.1rem, 1rem + .4vw, 1.3rem); max-width: 30rem; color: #fff; margin: 0 0 2rem; }

  .cta-btn {
    display: inline-flex; align-items: center; gap: .6em;
    min-height: 52px; padding: .9rem 1.6rem;
    border-radius: 999px;
    background: var(--c-cream); color: var(--c-ink);
    font: 700 1rem/1 var(--font-body); text-decoration: none;
    transition: transform .3s var(--ease), background-color .3s var(--ease);
  }
  .cta-btn:hover { background: #fff; transform: translateY(-2px); }
  .cta-btn:focus-visible, .news-btn:focus-visible, .news input:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }

  .news { margin-top: clamp(40px, 6vw, 64px); padding-top: 28px; border-top: 1px solid rgba(255,255,255,.4); max-width: 32rem; }
  .news-h { font-family: var(--font-display); font-weight: 400; text-transform: uppercase; font-size: 1.6rem; letter-spacing: .02em; margin: 0 0 .4rem; }
  .news-note { margin: 0 0 1rem; font-size: .95rem; color: #fff; }
  .news-row {
    display: flex; flex-wrap: wrap; gap: 8px;
    padding: 6px; border-radius: 999px;
    background: rgba(10,10,11,.35);
    border: 1px solid rgba(255,255,255,.35);
  }
  .news input {
    flex: 1 1 12rem; min-width: 0; min-height: 48px;
    padding: 0 1.1rem;
    border: 0; border-radius: 999px;
    background: transparent; color: #fff;
    font: 500 1rem/1 var(--font-body);
  }
  .news input::placeholder { color: rgba(255,255,255,.8); }
  .news-btn {
    flex: none; min-height: 48px; padding: 0 1.4rem;
    border: 0; border-radius: 999px; cursor: pointer;
    background: var(--c-ink); color: var(--c-cream);
    font: 700 .95rem/1 var(--font-body);
    transition: background-color .3s var(--ease);
  }
  .news-btn:hover { background: #000; }
  .news-msg { min-height: 1.6em; margin: .8rem 0 0; font-weight: 700; color: #fff; }

  .cta-art { margin: 0; position: relative; min-height: 320px; }
  .cta-art :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; }
  .cta-art::before {
    content: ""; position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: linear-gradient(180deg, rgba(214,0,10,.0) 60%, rgba(10,10,11,.55));
  }
  .cta-art figcaption {
    position: absolute; z-index: 2; right: 16px; bottom: 12px;
    font-size: .72rem; color: #fff; background: rgba(10,10,11,.6); padding: .25rem .6rem; border-radius: 999px;
  }

  @media (max-width: 959px) {
    .cta-art { order: -1; aspect-ratio: 16 / 10; min-height: 0; }
    .cta-art :global(img) { object-position: 50% 78%; }
    .news-row { border-radius: 24px; }
  }
  @media (max-width: 420px) {
    .news-btn { flex: 1 1 100%; }
  }
  @media (min-width: 960px) {
    .cta-panel { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); min-height: 720px; }
    .cta-art::before { left: -2px; background: linear-gradient(90deg, #D6000A 0%, rgba(214,0,10,0) 30%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .cta-btn, .news-btn { transition: none; }
    .cta-btn:hover { transform: none; }
  }
</style>
