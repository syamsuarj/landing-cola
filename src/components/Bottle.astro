---
/**
 * Siluet botol berlekuk buatan sendiri (SVG prosedural, bukan logo/aset resmi).
 * Props: label (aria-label; kosong = dekoratif/aria-hidden), color (warna pita label), class.
 * viewBox tetap 80x200 agar kompatibel dengan pemakaian lama.
 */
interface Props { label?: string; color?: string; class?: string }
const { label = '', color = '#F40009', class: cls = '' } = Astro.props;
const uid = `b${Math.random().toString(36).slice(2, 8)}`;
const deco = !label;
---
<svg
  viewBox="0 0 80 200" width="80" height="200" class={cls}
  role={deco ? undefined : 'img'} aria-label={deco ? undefined : label} aria-hidden={deco ? 'true' : undefined}
>
  <defs>
    <linearGradient id={`${uid}-glass`} x1="0" x2="1">
      <stop offset="0" stop-color="#120405" />
      <stop offset=".3" stop-color="#43100b" />
      <stop offset=".55" stop-color="#1c0605" />
      <stop offset="1" stop-color="#060202" />
    </linearGradient>
    <linearGradient id={`${uid}-hl`} x1="0" x2="0" y1="0" y2="1">
      <stop offset="0" stop-color="#fff" stop-opacity="0" />
      <stop offset=".5" stop-color="#fff" stop-opacity=".6" />
      <stop offset="1" stop-color="#fff" stop-opacity="0" />
    </linearGradient>
    <linearGradient id={`${uid}-cap`} x1="0" x2="1">
      <stop offset="0" stop-color="#8d9196" /><stop offset=".45" stop-color="#eef0f2" /><stop offset="1" stop-color="#6c7075" />
    </linearGradient>
  </defs>
  <path
    d="M31 9h18v13c0 8 4 14 8 22 5 10 8 18 8 30 0 12-6 20-6 30s7 18 7 34v38c0 7-5 12-12 12H28c-7 0-12-5-12-12v-38c0-16 7-24 7-34s-6-18-6-30c0-12 3-20 8-30 4-8 6-14 6-22z"
    fill={`url(#${uid}-glass)`} stroke="rgba(255,255,255,.22)" stroke-width="1"
  />
  <path d="M17.6 112c4 3 9 4 22.4 4s18.4-1 22.4-4v24c-4 3-9 4-22.4 4s-18.4-1-22.4-4z" fill={color} />
  <path d="M19 127q10.5-7 21-2t21-2" fill="none" stroke="#F5EFE6" stroke-width="2.2" stroke-linecap="round" />
  <path d="M25 48c-3 8-4 17-3 27M23 150c-1 10-1 20 0 32" fill="none" stroke={`url(#${uid}-hl)`} stroke-width="3" stroke-linecap="round" />
  <rect x="29" y="2" width="22" height="9" rx="2" fill={`url(#${uid}-cap)`} />
</svg>
