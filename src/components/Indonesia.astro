---
import { Image } from 'astro:assets';
import warung from '../assets/photos/indonesia-warung-malam.jpg';
import jalanan from '../assets/photos/indonesia-jalanan-malam.jpg';

const items = [
  { h: 'Dinikmati bersama', t: 'Di Indonesia, minuman bersoda sering hadir di momen kumpul keluarga, acara teman, hingga makan bersama di warung dan restoran.' },
  { h: 'Mitra lokal', t: 'Produk Coca-Cola di berbagai negara umumnya diproduksi dan didistribusikan melalui mitra pembotolan setempat. Detail perusahaan dan sejarah operasinya di Indonesia sebaiknya dicek di sumber resmi.' },
  { h: 'Mudah ditemukan', t: 'Tersedia umumnya di minimarket, supermarket, restoran, dan warung. Varian serta ukuran kemasan bisa berbeda antar daerah.' },
];
---
<section id="indonesia" class="ind grain" aria-labelledby="judul-indonesia">
  <div class="ind-bg" aria-hidden="true">
    <Image
      src={warung}
      alt=""
      widths={[640, 1024, 1440, 1800]}
      sizes="100vw"
      quality={70}
      loading="lazy"
      decoding="async"
      class="ind-bg-img"
      data-ind-parallax
    />
  </div>

  <div class="container ind-inner">
    <header class="ind-head" data-ind-reveal>
      <div class="ind-tag"><span class="dot" aria-hidden="true"></span>Gambaran umum · bukan data resmi</div>
      <h2 id="judul-indonesia" class="ind-title">
        <span class="ind-pre">Coca-Cola di</span>
        <span class="display-xl ind-big">Indonesia</span>
      </h2>
      <p class="ind-intro lead">Bagian ini sengaja ditulis secara umum. Kami hanya memuat hal yang kami yakin benar dan tidak mengklaim angka atau tanggal yang belum terverifikasi.</p>
    </header>

    <figure class="ind-inset" data-ind-reveal>
      <Image
        src={jalanan}
        alt="Suasana jalan kota yang ramai pada malam hari dengan lampu toko menyala"
        widths={[360, 560, 720]}
        sizes="(min-width: 960px) 360px, 80vw"
        quality={70}
        loading="lazy"
        decoding="async"
      />
      <figcaption>Suasana malam kota — foto stok ilustratif, bukan materi resmi.</figcaption>
    </figure>

    <ol class="ind-list">
      {items.map((i, n) => (
        <li class="ind-item" data-ind-item>
          <span class="ind-num" aria-hidden="true">0{n + 1}</span>
          <h3>{i.h}</h3>
          <p>{i.t}</p>
        </li>
      ))}
    </ol>
    <div class="ind-credit">Foto: Luthfian Alfajr &amp; Reyhan Aviseno / Unsplash</div>
  </div>
</section>

<script>
  import '../scripts/sections/indonesia';
</script>

<style>
  .ind {
    position: relative;
    overflow: clip;
    background: var(--c-ink);
    color: var(--c-cream);
    padding: clamp(96px, 14vw, 180px) 0 clamp(56px, 8vw, 96px);
  }
  .ind-bg { position: absolute; inset: 0 0 auto 0; height: min(100%, 1100px); z-index: 0; overflow: hidden; }
  .ind-bg :global(.ind-bg-img) {
    width: 100%; height: 112%;
    object-fit: cover; object-position: 50% 35%;
    filter: saturate(.95) contrast(1.05);
  }
  /* Overlay sinematik: gelap di kiri & bawah supaya teks >= 4.5:1, rona merah dalam di kanan atas */
  .ind-bg::after {
    content: ""; position: absolute; inset: 0;
    background:
      linear-gradient(180deg, rgba(10,10,11,.6) 0%, rgba(10,10,11,.3) 30%, rgba(10,10,11,.85) 65%, var(--c-ink) 100%),
      linear-gradient(90deg, rgba(10,10,11,.85) 0%, rgba(10,10,11,.2) 75%),
      radial-gradient(70% 55% at 85% 15%, rgba(142,0,16,.5), transparent 70%);
  }
  .ind-inner {
    position: relative; z-index: 2;
    display: grid; gap: clamp(32px, 5vw, 64px);
    grid-template-columns: minmax(0, 1fr);
  }
  .ind-tag {
    display: inline-flex; align-items: center; gap: .6em;
    font-size: .75rem; font-weight: 700; letter-spacing: .18em; text-transform: uppercase;
    color: var(--c-cream);
    border: 1px solid rgba(245,239,230,.35); border-radius: 999px;
    padding: .55em 1.1em; margin: 0 0 1.75rem;
    background: rgba(10,10,11,.6);
  }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--c-red); box-shadow: 0 0 12px var(--c-red); flex: none; }
  .ind-title { margin: 0 0 1.75rem; }
  .ind-pre {
    display: block;
    font-family: var(--font-serif); font-style: italic; font-weight: 400;
    font-size: clamp(1.75rem, 3.5vw, 3rem); line-height: 1; margin-bottom: .15em;
    color: var(--c-cream);
  }
  .ind-big { display: block; color: var(--c-cream); text-shadow: 0 10px 60px rgba(0,0,0,.5); }
  .ind-intro { max-width: 34rem; color: var(--c-cream); margin: 0; }

  .ind-inset { margin: 0; width: min(100%, 360px); }
  .ind-inset :global(img) {
    width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover;
    border-radius: var(--radius);
    box-shadow: 0 30px 80px rgba(0,0,0,.6);
  }
  .ind-inset figcaption { margin-top: .75rem; font-size: .85rem; color: var(--c-muted); }

  .ind-list {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: minmax(0, 1fr);
    border-top: 1px solid rgba(245,239,230,.2);
  }
  .ind-item {
    padding: 28px 0;
    border-bottom: 1px solid rgba(245,239,230,.2);
    display: grid; grid-template-columns: 3.25rem minmax(0, 1fr); column-gap: 1rem;
  }
  .ind-num {
    grid-row: span 2;
    font-family: var(--font-display); font-size: 2rem; line-height: 1;
    color: var(--c-red);
  }
  .ind-item h3 { font-size: clamp(1.25rem, 1.1rem + .6vw, 1.6rem); margin: 0 0 .5rem; }
  .ind-item p { margin: 0; color: var(--c-muted); }
  .ind-credit { font-size: .75rem; color: var(--c-muted); }

  @media (min-width: 960px) {
    .ind { min-height: 100svh; }
    .ind-inner { grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); align-items: end; }
    .ind-inset { justify-self: end; }
    .ind-list { grid-column: 1 / -1; grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: 40px; border-top: 0; margin-top: 24px; }
    .ind-item {
      border-bottom: 0; border-top: 1px solid rgba(245,239,230,.3);
      padding: 28px 0 0;
      grid-template-columns: minmax(0, 1fr);
    }
    .ind-num { grid-row: auto; margin-bottom: 1.25rem; font-size: 2.75rem; }
    .ind-credit { grid-column: 1 / -1; }
  }
</style>
