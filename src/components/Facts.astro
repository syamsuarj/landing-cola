---
import { Image } from 'astro:assets';
import fotoEs from '../assets/photos/fakta-es.jpg';

// Koreksi QA-T4B #3: "200+ negara dan wilayah".
// Nilai akhir sudah tertulis di HTML (benar tanpa JS); JS hanya menganimasikan hitungan.
const facts = [
  { n: '1886', to: 1886, from: 1800, s: '', t: 'Tahun pertama kali diracik' },
  { n: '200+', to: 200, from: 0, s: '+', t: 'Negara dan wilayah tempat produknya dijual' },
  { n: '1915', to: 1915, from: 1850, s: '', t: 'Tahun desain botol kontur dibuat' },
  { n: 'Atlanta', to: null, from: null, s: '', t: 'Kota kelahiran Coca-Cola' },
];
---
<section id="fakta" class="fk grain" aria-labelledby="judul-fakta">
  <div class="fk-bg" aria-hidden="true">
    <Image src={fotoEs} alt="" widths={[640, 1200, 1800]} sizes="100vw" loading="lazy" />
  </div>
  <div class="container fk-inner">
    <div class="fk-head">
      <p class="eyebrow fk-eyebrow" data-fk-reveal>04 · Angka</p>
      <h2 id="judul-fakta" class="display-m fk-title" data-fk-reveal>Fakta <span class="serif">singkat</span></h2>
    </div>
    <dl class="fk-list">
      {facts.map((f, i) => (
        <div class:list={['fk-item', `fk-item-${i + 1}`, { 'is-word': f.to === null }]} data-fk-item>
          <dt class="fk-label">{f.t}</dt>
          <dd class="fk-num">
            <span data-fk-to={f.to ?? undefined} data-fk-from={f.from ?? undefined} data-fk-suffix={f.s}>{f.n}</span>
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  /* Blok merah: latar #C30009–#8E0010 → putih ≥ 5.4:1 untuk teks kecil */
  .fk {
    position: relative; overflow: hidden; overflow-x: clip;
    background:
      radial-gradient(70% 80% at 0% 0%, #DE000A 0%, transparent 60%),
      linear-gradient(160deg, #D0000A 0%, #B50009 60%, #9A0010 100%);
    color: #fff;
    padding-block: clamp(80px, 10vw, 144px) clamp(64px, 8vw, 112px);
  }
  .fk-bg { position: absolute; inset: 0; z-index: 0; mix-blend-mode: soft-light; opacity: .45; }
  .fk-bg :global(img) { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.2) brightness(1.6); }
  .fk-inner { position: relative; z-index: 2; }
  .fk-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: .5rem 2rem; margin-bottom: clamp(32px, 5vw, 64px); }
  .fk-eyebrow { color: rgba(255,255,255,.88); order: 2; margin: 0; }
  .fk-title { margin: 0; }
  .fk-title .serif { font-size: .85em; }

  .fk-list { margin: 0; display: grid; grid-template-columns: minmax(0, 1fr); border-top: 1px solid rgba(255,255,255,.35); }
  .fk-item {
    display: flex; flex-direction: column-reverse; justify-content: flex-end;
    padding: clamp(24px, 3vw, 40px) 0;
    border-bottom: 1px solid rgba(255,255,255,.35);
    min-width: 0;
  }
  .fk-num {
    margin: 0;
    font-family: var(--font-display); font-weight: 400; text-transform: uppercase;
    font-size: clamp(5rem, 27vw, 15rem); line-height: .82; letter-spacing: -.01em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .is-word .fk-num { font-size: clamp(4rem, 19vw, 11rem); color: transparent; -webkit-text-stroke: 2px #fff; }
  .fk-label { margin-top: .9rem; font-weight: 700; font-size: clamp(1rem, .95rem + .3vw, 1.2rem); max-width: 22rem; }

  @media (min-width: 768px) {
    .fk-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .fk-item:nth-child(odd) { padding-right: clamp(16px, 3vw, 48px); border-right: 1px solid rgba(255,255,255,.35); }
    .fk-item:nth-child(even) { padding-left: clamp(16px, 3vw, 48px); }
    .fk-num { font-size: clamp(5rem, 13vw, 13rem); }
    .is-word .fk-num { font-size: clamp(3.5rem, 9.5vw, 9.5rem); }
  }
</style>

<script>
  import '../scripts/sections/facts';
</script>
