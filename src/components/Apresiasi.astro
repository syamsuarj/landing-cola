---
// T1b — Sambutan "Harapan & Apresiasi". Teks resmi: docs/reference/t1b-content.md (agrinaspalma.co.id).
const surat =
  'Terima kasih kami sampaikan kepada seluruh masyarakat Indonesia atas dukungannya kepada PT Agrinas Palma Nusantara (Persero). Kami hadir untuk memberikan manfaat bagi masyarakat melalui solusi berkelanjutan di sektor kelapa sawit dan konsultan konstruksi. Kami berkomitmen untuk terus berkontribusi dalam pembangunan ekonomi dan ketahanan industri nasional.';
const words = surat.split(' ');
const cards = [
  {
    t: 'Keterbukaan Informasi',
    d: 'Kami mengapresiasi peran media nasional dalam mengedukasi publik, menyampaikan perkembangan Agrinas Palma Nusantara, serta mendukung transparansi dan keterbukaan informasi publik secara berkelanjutan.',
  },
  {
    t: 'Sinergi Tumbuh Bersama',
    d: 'Bersama pemerintah dan para pemangku kepentingan strategis, kami siap mendukung pertumbuhan industri yang mandiri, berdaya saing tinggi, dan ramah lingkungan demi kemakmuran masyarakat Indonesia.',
  },
];
---
<section id="apresiasi" class="ap section-light grain" aria-labelledby="judul-apresiasi">
  <div class="container">
    <header class="ap-head">
      <p class="eyebrow" data-ap-reveal>Sambutan</p>
      <h2 id="judul-apresiasi" class="display-l ap-title" data-ap-reveal>Harapan &amp; <span class="accent">Apresiasi</span></h2>
      <p class="lead muted ap-sub" data-ap-reveal>Dedikasi tulus kami untuk seluruh lapisan masyarakat Nusantara.</p>
    </header>

    <figure class="ap-letter">
      <span class="ap-mark" aria-hidden="true">&ldquo;</span>
      <blockquote class="ap-quote">
        <p class="ap-salam" data-ap-reveal>Kepada seluruh pemangku kepentingan yang kami hormati dan banggakan,</p>
        <p class="ap-body" data-ap-words>{words.map((w, i) => <span class="ap-w">{i < words.length - 1 ? w + ' ' : w}</span>)}</p>
      </blockquote>
      <figcaption class="ap-sign" data-ap-reveal>
        <span class="ap-thanks">Terima Kasih</span>
        <span class="ap-org">PT Agrinas Palma Nusantara (Persero)</span>
      </figcaption>
    </figure>

    <ul class="ap-cards" role="list">
      {cards.map((c, i) => (
        <li class="ap-card" data-ap-card>
          <span class="logo-stripe" aria-hidden="true"></span>
          <span class="ap-num" aria-hidden="true">0{i + 1}</span>
          <h3 class="ap-card-t">{c.t}</h3>
          <p>{c.d}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .ap {
    padding-block: clamp(88px, 12vw, 168px);
    overflow-x: clip;
    background:
      radial-gradient(55% 40% at 100% 0%, rgba(161, 219, 179, .35), transparent 70%),
      var(--c-cream);
  }
  .ap > * { position: relative; z-index: 2; }
  .ap-head { max-width: 52rem; }
  .ap-title { margin: .15em 0 .3em; }
  .ap-sub { margin: 0; max-width: 34rem; }

  /* ---------- Surat ---------- */
  .ap-letter {
    position: relative;
    margin: clamp(48px, 8vw, 112px) 0 0;
    padding-top: clamp(64px, 16vw, 120px);
  }
  .ap-mark {
    position: absolute; left: -.06em; top: -.2em;
    font-family: var(--font-display); font-style: italic;
    font-size: clamp(7rem, 18vw, 15rem); line-height: 1;
    color: var(--c-green);
    pointer-events: none;
  }
  .ap-quote { margin: 0; }
  .ap-salam {
    font-family: var(--font-display); font-style: italic;
    font-size: clamp(1.1rem, 1rem + .6vw, 1.5rem);
    color: var(--c-green); margin: 0 0 1.1em;
  }
  .ap-body {
    font-family: var(--font-display); font-weight: 400;
    font-size: clamp(1.4rem, 1rem + 2vw, 2.75rem);
    line-height: 1.3; letter-spacing: -.01em;
    color: var(--c-forest);
    max-width: 30em; margin: 0;
  }
  .ap-sign {
    display: flex; flex-direction: column; gap: .2rem;
    margin-top: clamp(28px, 4vw, 48px);
    padding-top: 1.25rem; border-top: 1px solid var(--c-line-dark);
    max-width: 30rem;
  }
  .ap-thanks { font-family: var(--font-display); font-style: italic; font-size: 1.35rem; color: var(--c-green); }
  .ap-org { font-weight: 700; font-size: .8rem; letter-spacing: .12em; text-transform: uppercase; color: var(--c-forest); }
  @media (min-width: 900px) {
    .ap-letter { padding-left: clamp(120px, 12vw, 180px); padding-top: 0; }
    .ap-mark { left: 0; top: -.12em; }
  }

  /* ---------- Kartu ---------- */
  .ap-cards {
    list-style: none; margin: clamp(56px, 8vw, 112px) 0 0; padding: 0;
    display: grid; gap: clamp(16px, 2.5vw, 28px);
  }
  .ap-card {
    position: relative; overflow: hidden;
    background: var(--c-paper);
    border: 1px solid var(--c-line-dark);
    border-radius: var(--radius);
    padding: clamp(28px, 3.5vw, 44px);
  }
  .ap-card .logo-stripe { position: absolute; inset: 0 0 auto 0; }
  .ap-num { display: block; font-family: var(--font-display); font-style: italic; font-size: 1.1rem; color: var(--c-green); margin-bottom: .75rem; }
  .ap-card-t { font-family: var(--font-display); font-weight: 500; font-size: clamp(1.5rem, 1.1rem + 1.2vw, 2.1rem); margin: 0 0 .6em; color: var(--c-forest); }
  .ap-card p { margin: 0; color: var(--c-muted-dark); line-height: 1.65; }
  @media (min-width: 768px) {
    .ap-cards { grid-template-columns: 1fr 1fr; }
  }
</style>

<script>
  import '../scripts/sections/apresiasi';
</script>
