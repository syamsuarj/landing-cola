---
/* T11 — Latar hero "studio gelap": gradien ink + kontur topografi emas/mint (motif peta lahan, prosedural)
 * + foto kebun pre-blur duotone (≈1 KB) di sepertiga bawah + sorotan & bayangan elips yang mengikuti diorama + kabut.
 * Hook [data-hero-bg] (zoom/parallax di animations.ts) ada di lapisan .far (kontur + foto).
 * Posisi sorotan: default CSS = posisi diorama babak 1 (juga untuk tanpa-JS/reduced-motion); skrip kecil di bawah
 * menyalin pusat [data-hero-object] (setelah transform GSAP) ke `translate` .spot/.floor — tanpa edit animations.ts. */
import fs from 'node:fs';
import path from 'node:path';
// Foto pre-blur (1,2 KB) di-inline sebagai data URI: terlukis bersama first paint → bila jadi kandidat LCP, LCP ≈ FCP
// (versi <img src> + fetchpriority=low sempat menjadi elemen LCP yang terlambat, LH 2026-10-08).
const fieldSrc = 'data:image/webp;base64,' + fs.readFileSync(path.join(process.cwd(), 'src/assets/agrinas/hero-sawit1-blur.webp')).toString('base64');

// ---- Kontur topografi: cincin bersarang di sekitar beberapa "bukit", seeded agar build deterministik ----
function rng(seed: number) {
  return () => {
    seed |= 0; seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
type Hill = { cx: number; cy: number; r0: number; step: number; n: number; seed: number; sx?: number };
// viewBox 1600×1000; bukit utama kanan-bawah (panggung babak 1/3), bukit kedua kiri-bawah (babak 2), sisa di atas
const hills: Hill[] = [
  { cx: 1210, cy: 700, r0: 34, step: 30, n: 17, seed: 7, sx: 1.45 },
  { cx: 330, cy: 760, r0: 26, step: 30, n: 13, seed: 21, sx: 1.35 },
  { cx: 820, cy: -40, r0: 60, step: 34, n: 9, seed: 5, sx: 1.6 },
];
const N = 22; // titik per cincin
const rings: { d: string; idx: boolean; minor: boolean }[] = [];
for (const h of hills) {
  const r = rng(h.seed);
  // bentuk bersama (harmonik rendah) → cincin bersarang tanpa saling potong
  const harm = [2, 3, 5].map((k) => ({ k, a: (0.06 + r() * 0.08) / (k * 0.6), p: r() * Math.PI * 2 }));
  const drift = [r() * 2 - 1, r() * 2 - 1];
  for (let i = 0; i < h.n; i++) {
    const base = h.r0 + i * h.step;
    const ph = r() * Math.PI * 2;
    const pts: [number, number][] = [];
    for (let j = 0; j < N; j++) {
      const th = (j / N) * Math.PI * 2;
      let f = 1;
      for (const { k, a, p } of harm) f += a * (1 + i * 0.05) * Math.sin(k * th + p + i * 0.04);
      const rr = base * f + h.step * 0.18 * Math.sin(3 * th + ph);
      // pusat sedikit bergeser per cincin → lereng tak simetris (curam di satu sisi)
      const ox = drift[0] * i * 7, oy = drift[1] * i * 4;
      pts.push([h.cx + ox + Math.cos(th) * rr * (h.sx ?? 1), h.cy + oy + Math.sin(th) * rr]);
    }
    // kurva halus melalui titik tengah (Q dengan kontrol = titik)
    const mid = (a: [number, number], b: [number, number]) => [Math.round((a[0] + b[0]) / 2), Math.round((a[1] + b[1]) / 2)];
    let d = `M${mid(pts[N - 1], pts[0]).join(' ')}`;
    for (let j = 0; j < N; j++) d += `Q${Math.round(pts[j][0])} ${Math.round(pts[j][1])} ${mid(pts[j], pts[(j + 1) % N]).join(' ')}`;
    rings.push({ d, idx: i % 5 === 4, minor: i % 2 === 1 && i % 5 !== 4 });
  }
}
---
<div class="backdrop" aria-hidden="true" data-hero-backdrop>
  <div class="far" data-hero-bg>
    <svg class="topo" viewBox="0 0 1600 1000" preserveAspectRatio="xMidYMid slice" focusable="false">
      {rings.map((g, i) => (
        <path d={g.d} class:list={[g.idx ? 'idx' : i % 3 === 0 ? 'gold' : 'mint', g.minor && 'minor']} />
      ))}
    </svg>
    <img class="field" src={fieldSrc} width="480" height="147" alt="" />
  </div>
  <div class="spot"></div>
  <div class="floor"></div>
  <div class="mist"></div>
</div>

<script>
  // Sorotan & bayangan mengikuti pusat diorama (posisi setelah transform GSAP). Hanya aktif saat hero terlihat.
  const bd = document.querySelector<HTMLElement>('[data-hero-backdrop]');
  const obj = document.querySelector<HTMLElement>('[data-hero-object]');
  if (bd && obj) {
    const spot = bd.querySelector<HTMLElement>('.spot')!;
    const floor = bd.querySelector<HTMLElement>('.floor')!;
    // GSAP scrub (0.6 s) masih menggerakkan objek setelah event scroll berhenti → ikuti per frame sampai posisi stabil
    let raf = 0, live = false, still = 0, last = '';
    const place = () => {
      raf = 0;
      const o = obj.getBoundingClientRect(), b = bd.getBoundingClientRect();
      // T12b R-2: diorama tersembunyi (display:none → rect 0×0, visibility/opacity 0) → sembunyikan glow/bayangan, berhenti (tanpa rAF saat diam)
      const cs = getComputedStyle(obj);
      const hidden = o.width < 2 || o.height < 2 || cs.visibility === 'hidden' || +cs.opacity === 0;
      bd.toggleAttribute('data-no-object', hidden);
      if (hidden) { last = ''; return; }
      const x = o.left + o.width / 2 - b.left, y = o.top + o.height / 2 - b.top;
      const key = `${x.toFixed(1)}|${y.toFixed(1)}|${o.width.toFixed(0)}|${o.height.toFixed(0)}`;
      if (key === last) { if (++still > 12) return; } else {
        still = 0; last = key;
        spot.style.translate = `${x.toFixed(1)}px ${y.toFixed(1)}px`;
        // bayangan di bawah pulau (≈ 0,26 tinggi wadah di bawah pusat), lebar mengikuti lebar wadah
        floor.style.translate = `${x.toFixed(1)}px ${(y + o.height * 0.26).toFixed(1)}px`;
        floor.style.width = `${(o.width * 0.86).toFixed(0)}px`;
      }
      raf = requestAnimationFrame(place);
    };
    const req = () => { still = 0; if (live && !raf) raf = requestAnimationFrame(place); };
    new IntersectionObserver(([e]) => { live = e.isIntersecting; req(); }).observe(bd);
    addEventListener('scroll', req, { passive: true });
    addEventListener('resize', req);
    addEventListener('pageshow', req);
  }
</script>

<style>
  .backdrop {
    position: absolute; inset: 0; z-index: 0; overflow: hidden; pointer-events: none;
    /* studio: lantai sedikit lebih terang di panggung kanan-tengah, vinyet gelap ke tepi */
    background:
      radial-gradient(ellipse 62% 58% at 64% 52%, #12301f 0%, rgba(14, 34, 24, .7) 38%, rgba(7, 21, 14, 0) 72%),
      radial-gradient(ellipse 40% 45% at 26% 60%, rgba(18, 48, 31, .55) 0%, rgba(7, 21, 14, 0) 70%),
      linear-gradient(180deg, #040d08 0%, var(--c-ink) 30%, var(--c-ink-2) 72%, var(--c-ink) 100%);
  }
  .backdrop::after { /* vinyet */
    content: ""; position: absolute; inset: 0;
    background: radial-gradient(ellipse 85% 80% at 55% 50%, rgba(3, 9, 6, 0) 55%, rgba(3, 9, 6, .7) 100%);
  }
  .far { position: absolute; inset: 0; transform-origin: 60% 55%; }

  /* kontur: 1px non-scaling; emas & mint opacity rendah; garis indeks (tiap 5) sedikit lebih tegas */
  .topo {
    position: absolute; inset: 0; width: 100%; height: 100%;
    fill: none; stroke-width: 1; vector-effect: non-scaling-stroke;
    -webkit-mask-image: radial-gradient(ellipse 75% 85% at 58% 58%, #000 35%, rgba(0, 0, 0, .25) 100%);
    mask-image: radial-gradient(ellipse 75% 85% at 58% 58%, #000 35%, rgba(0, 0, 0, .25) 100%);
  }
  .topo path { vector-effect: non-scaling-stroke; }
  .topo .mint { stroke: var(--c-mint); stroke-opacity: .09; }
  .topo .gold { stroke: var(--c-yellow); stroke-opacity: .08; }
  .topo .idx { stroke: var(--c-yellow); stroke-opacity: .16; stroke-width: 1.15; }

  /* foto kebun: pre-blur + duotone (aset 480px), hanya sepertiga bawah, memudar ke atas */
  .field {
    position: absolute; left: 0; right: 0; bottom: 0; width: 100%; height: 38%;
    object-fit: cover; object-position: 50% 30%; opacity: .17;
    -webkit-mask-image: linear-gradient(0deg, #000 0%, #000 30%, transparent 100%);
    mask-image: linear-gradient(0deg, #000 0%, #000 30%, transparent 100%);
  }

  /* sorotan & bayangan: posisi = translate (diisi skrip); default = pusat diorama babak 1 */
  .spot, .floor { position: absolute; left: 0; top: 0; transform: translate(-50%, -50%); will-change: translate; }
  .spot {
    translate: 72vw 50svh;
    width: min(980px, 120vw); aspect-ratio: 1;
    background:
      radial-gradient(closest-side, rgba(242, 194, 48, .15), rgba(242, 194, 48, .05) 40%, rgba(161, 219, 179, .035) 58%, rgba(7, 21, 14, 0) 76%);
  }
  .floor {
    translate: 72vw calc(50svh + 23svh);
    width: min(36vw, 480px); aspect-ratio: 4.2;
    background: radial-gradient(closest-side, rgba(1, 5, 3, .6), rgba(1, 5, 3, .34) 45%, rgba(242, 194, 48, .06) 72%, rgba(242, 194, 48, 0) 100%);
  }
  /* T12b R-2/W-2: tanpa diorama (tinggi ≤500px → .object display:none; atau objek tak terlihat menurut skrip) → tanpa noda glow/bayangan */
  .backdrop[data-no-object] .spot, .backdrop[data-no-object] .floor { display: none; }
  @media (max-height: 500px) { .spot, .floor { display: none; } }
  /* kabut tipis di bawah + transisi ke section berikutnya */
  .mist {
    position: absolute; left: 0; right: 0; bottom: 0; height: 46%;
    background:
      radial-gradient(ellipse 70% 60% at 60% 100%, rgba(161, 219, 179, .06), rgba(161, 219, 179, 0) 70%),
      linear-gradient(180deg, rgba(7, 21, 14, 0) 0%, rgba(14, 34, 24, .18) 60%, rgba(7, 21, 14, .8) 92%, var(--c-ink) 100%);
  }

  @media (max-width: 1023px) {
    .spot { translate: 78vw 50svh; }
    .floor { translate: 78vw calc(50svh + 23svh); width: 40vw; }
  }
  /* mobile ringan: separuh garis kontur, tanpa mask radial di SVG, sorotan lebih kecil */
  @media (max-width: 760px) {
    .topo .minor { display: none; }
    .topo { -webkit-mask-image: none; mask-image: none; opacity: .85; }
    .spot { translate: 72vw calc(66svh - 7.5rem + 17svh); width: 140vw; }
    .floor { translate: 72vw calc(66svh - 7.5rem + 27svh); width: 48vw; }
    .field { height: 30%; }
  }
</style>
