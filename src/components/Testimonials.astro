---
const quotes = [
  { q: 'Dingin, bersoda, dan selalu ada di setiap kumpul keluarga.', a: 'Contoh pengunjung A' },
  { q: 'Botol kecil favoritku untuk teman makan siang.', a: 'Contoh pengunjung B' },
  { q: 'Suka varian tanpa gula untuk sesekali menikmati rasa cola.', a: 'Contoh pengunjung C' },
];
---
<section id="kutipan" class="kut grain" aria-labelledby="judul-kutipan">
  <div class="container kut-head" data-kut-head>
    <h2 id="judul-kutipan" class="display-l kut-title">Kata <span class="text-red">Mereka</span></h2>
    <div class="kut-label"><strong>Ilustrasi:</strong> kutipan berikut fiktif untuk demo desain, bukan testimoni nyata.</div>
  </div>

  <div class="kut-viewport" data-kut-viewport>
    <ul class="kut-track" data-kut-track>
      {quotes.map((x) => (
        <li class="kut-card">
          <figure>
            <span class="kut-mark" aria-hidden="true">“</span>
            <blockquote><p>{x.q}</p></blockquote>
            <figcaption>— {x.a} <em>(ilustrasi)</em></figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>

  <div class="container kut-ctrl">
    <button type="button" class="kut-toggle" data-kut-toggle hidden aria-pressed="false">
      <span class="kut-ico" aria-hidden="true"></span><span data-kut-label>Jeda gerakan</span>
    </button>
  </div>
</section>

<script>
  import '../scripts/sections/testimonials';
</script>

<style>
  .kut {
    position: relative;
    overflow-x: clip;
    background:
      radial-gradient(60% 50% at 15% 0%, rgba(142,0,16,.45), transparent 70%),
      var(--c-ink);
    color: var(--c-cream);
    padding: clamp(88px, 12vw, 160px) 0 clamp(64px, 8vw, 112px);
  }
  .kut-head {
    position: relative; z-index: 2;
    display: grid; gap: 1.25rem; grid-template-columns: minmax(0, 1fr);
    margin-bottom: clamp(32px, 5vw, 64px);
  }
  .kut-title { color: var(--c-cream); }
  .kut-label {
    justify-self: start;
    font-size: .9rem; color: var(--c-cream);
    border: 1px dashed rgba(245,239,230,.45); border-radius: 999px;
    padding: .55rem 1.1rem;
    max-width: 100%;
  }
  .kut-label strong { color: #fff; letter-spacing: .04em; }

  .kut-viewport { position: relative; z-index: 2; overflow: hidden; }
  /* Tanpa JS / reduced-motion: daftar statis rapi dalam container */
  .kut-track {
    list-style: none; margin: 0 auto; padding: 0 var(--gutter);
    max-width: var(--container);
    display: grid; gap: 16px; grid-template-columns: minmax(0, 1fr);
  }
  .kut-card figure {
    margin: 0; height: 100%;
    display: flex; flex-direction: column;
    padding: clamp(24px, 3vw, 40px);
    border-radius: var(--radius);
    background: linear-gradient(160deg, rgba(245,239,230,.07), rgba(245,239,230,.02));
    border: 1px solid rgba(245,239,230,.12);
  }
  .kut-mark { font-family: var(--font-serif); font-size: 5rem; line-height: .6; color: var(--c-red); height: 2.25rem; }
  blockquote { margin: 0 0 1.5rem; flex: 1; }
  blockquote p {
    margin: 0;
    font-family: var(--font-serif); font-style: italic;
    font-size: clamp(1.5rem, 1.2rem + 1.1vw, 2.25rem); line-height: 1.15;
    color: var(--c-cream);
  }
  figcaption { color: var(--c-muted); font-size: .9rem; }
  figcaption em { font-style: normal; color: var(--c-cream); }

  @media (min-width: 800px) {
    .kut-head { grid-template-columns: minmax(0, 1fr) auto; align-items: end; }
    .kut-track { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  }

  /* Mode marquee (diaktifkan JS bila tidak reduced-motion) */
  .kut-viewport.is-marquee {
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
            mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .kut-viewport.is-marquee .kut-track {
    display: flex; width: max-content; max-width: none;
    gap: 24px; padding: 0 12px;
    margin: 0;
    will-change: transform;
  }
  .kut-viewport.is-marquee .kut-card { width: clamp(280px, 80vw, 440px); flex: none; }

  .kut-ctrl { position: relative; z-index: 2; margin-top: 28px; display: flex; justify-content: flex-end; }
  .kut-toggle {
    display: inline-flex; align-items: center; gap: .6rem;
    min-height: 44px; padding: .5rem 1rem;
    border-radius: 999px;
    background: transparent; color: var(--c-cream);
    border: 1px solid rgba(245,239,230,.35);
    font: 600 .85rem/1 var(--font-body);
    cursor: pointer;
  }
  .kut-toggle[hidden] { display: none; }
  .kut-toggle:hover { border-color: var(--c-cream); }
  .kut-ico { width: 10px; height: 12px; border-left: 3px solid currentColor; border-right: 3px solid currentColor; }
  .kut-toggle[aria-pressed="true"] .kut-ico {
    border: 0; width: 0; height: 0;
    border-left: 10px solid currentColor; border-top: 6px solid transparent; border-bottom: 6px solid transparent;
  }
</style>
