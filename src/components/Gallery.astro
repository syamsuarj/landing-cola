---
import { Image } from 'astro:assets';
import piknik from '../assets/photos/galeri-piknik.jpg';
import nobar from '../assets/photos/galeri-nonton-bareng.jpg';
import makan from '../assets/photos/galeri-makan-keluarga.jpg';
import ultah from '../assets/photos/galeri-ulang-tahun.jpg';
import jalan from '../assets/photos/galeri-perjalanan.jpg';
import olahraga from '../assets/photos/galeri-olahraga.jpg';

const tiles = [
  { t: 'Makan malam keluarga', img: makan, alt: 'Keluarga dengan anak-anak makan bersama di meja makan sambil tersenyum', by: 'Tyson' },
  { t: 'Piknik akhir pekan', img: piknik, alt: 'Sekelompok teman duduk santai berpiknik di taman', by: 'Vitaly Gariev' },
  { t: 'Nonton bareng', img: nobar, alt: 'Tribun stadion penuh penonton dengan bendera merah', by: 'Ahmet Kurt' },
  { t: 'Olahraga bersama', img: olahraga, alt: 'Pertandingan sepak bola di stadion dengan tribun penonton', by: 'Lamina Amedo' },
  { t: 'Pesta ulang tahun', img: ultah, alt: 'Kue ulang tahun dengan lilin menyala dalam ruangan gelap', by: 'Waldemar Brandt' },
  { t: 'Perjalanan santai', img: jalan, alt: 'Foto hitam putih dua orang di dalam mobil saat perjalanan', by: 'Odile' },
];
---
<section id="galeri" class="gal-sec" aria-labelledby="judul-galeri">
  <div class="container">
    <div class="gal-head" data-gal-head>
      <h2 id="judul-galeri" class="display-l gal-title">Galeri <span class="serif gal-title-s">Momen</span></h2>
      <p class="gal-intro">Foto stok suasana (Unsplash, lisensi bebas) tentang momen kebersamaan. Bukan foto atau materi resmi.</p>
    </div>

    <ul class="gal-grid">
      {tiles.map((t, i) => (
        <li class="gal-item" data-gal-item>
          <figure>
            <div class="gal-clip">
              <Image
                src={t.img}
                alt={t.alt}
                widths={[360, 560, 800]}
                sizes="(min-width: 960px) 30vw, 46vw"
                quality={68}
                loading="lazy"
                decoding="async"
              />
            </div>
            <figcaption>
              <span class="gal-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="gal-t">{t.t}</span>
              <span class="gal-by">Foto: {t.by} / Unsplash</span>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  import '../scripts/sections/gallery';
</script>

<style>
  .gal-sec {
    position: relative;
    overflow-x: clip;
    background: var(--c-ink);
    color: var(--c-cream);
    padding: clamp(88px, 12vw, 160px) 0;
  }
  .gal-head {
    display: grid; gap: 1.25rem;
    grid-template-columns: minmax(0, 1fr);
    margin-bottom: clamp(32px, 5vw, 64px);
  }
  .gal-title { color: var(--c-cream); }
  .gal-title-s { color: var(--c-red); display: inline-block; font-size: .8em; }
  .gal-intro { margin: 0; color: var(--c-muted); max-width: 26rem; }

  .gal-grid {
    list-style: none; margin: 0; padding: 0;
    columns: 2; column-gap: 12px;
  }
  .gal-item { break-inside: avoid; margin: 0 0 12px; }
  .gal-item figure { margin: 0; position: relative; }
  .gal-clip { overflow: hidden; border-radius: calc(var(--radius) * .7); background: var(--c-ink-2); }
  .gal-clip :global(img) {
    width: 100%; height: auto;
    transition: transform .9s var(--ease), filter .9s var(--ease);
    filter: saturate(.92);
  }
  .gal-item:hover .gal-clip :global(img) { transform: scale(1.04); filter: saturate(1.05); }

  figcaption {
    display: grid; grid-template-columns: auto minmax(0, 1fr); column-gap: .6rem; row-gap: .1rem;
    padding: .7rem .1rem 0;
  }
  .gal-n { font-family: var(--font-display); color: var(--c-red); font-size: 1rem; line-height: 1.4; }
  .gal-t { font-weight: 700; font-size: .95rem; line-height: 1.35; }
  .gal-by { grid-column: 2; font-size: .72rem; color: var(--c-muted); }

  @media (min-width: 720px) {
    .gal-grid { column-gap: 20px; }
    .gal-item { margin-bottom: 20px; }
  }
  @media (min-width: 960px) {
    .gal-head { grid-template-columns: minmax(0, 1fr) auto; align-items: end; }
    .gal-grid { columns: 3; column-gap: 24px; }
    .gal-item { margin-bottom: 32px; }
    /* Offset kolom tengah agar ritme masonry terasa editorial */
    .gal-t { font-size: 1.05rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .gal-clip :global(img) { transition: none; }
    .gal-item:hover .gal-clip :global(img) { transform: none; }
  }
</style>
