---
import { Image } from 'astro:assets';
import fotoGelembung from '../assets/photos/produk-gelembung.jpg';

// Koreksi fakta QA-T4B: #5 Original "cita rasa klasik sejak 1886", #2 Light/Diet "tanpa/rendah kalori", #4 Cherry "ketersediaan berbeda".
// Warna identitas: Original merah, Zero hitam, Light perak, Cherry merah tua. Botol = SVG buatan sendiri (tanpa logo).
const products = [
  { id: 'original', brand: 'Coca-Cola', word: 'Original', name: 'Coca-Cola Original',
    desc: 'Cola yang menyegarkan dengan cita rasa klasik yang sudah ada sejak 1886.',
    pts: ['Rasa cola klasik, mengandung gula', 'Pasangan populer untuk makan bersama', 'Paling nikmat disajikan dingin'],
    cap: '#F40009', label: '#F40009', ribbon: '#FFFFFF' },
  { id: 'zero', brand: 'Coca-Cola', word: 'Zero Sugar', name: 'Coca-Cola Zero Sugar',
    desc: 'Rasa mirip Original tanpa gula, untuk kamu yang ingin mengurangi asupan gula.',
    pts: ['Tanpa gula, memakai pemanis pengganti', 'Dirancang mendekati rasa Original', 'Tetap minuman bersoda berkafein, bukan produk kesehatan'],
    cap: '#111113', label: '#141416', ribbon: '#F40009' },
  { id: 'light', brand: 'Coca-Cola', word: 'Light / Diet', name: 'Coca-Cola Light / Diet',
    desc: 'Pilihan tanpa/rendah kalori dengan rasa yang lebih ringan dan menyegarkan.',
    pts: ['Tanpa/rendah kalori — cek label kemasan', 'Profil rasa tersendiri yang lebih ringan', 'Di tiap negara namanya bisa Light atau Diet'],
    cap: '#C9CDD2', label: '#D9DCE0', ribbon: '#F40009' },
  { id: 'cherry', brand: 'Coca-Cola', word: 'Cherry', name: 'Coca-Cola Cherry',
    desc: 'Perpaduan rasa cola klasik dengan sentuhan manis buah ceri.',
    pts: ['Cola dengan aroma dan rasa ceri', 'Cocok untuk yang suka sensasi manis buah', 'Ketersediaan berbeda di tiap negara'],
    cap: '#8E0010', label: '#8E0010', ribbon: '#F5EFE6' },
];
const pad = (n: number) => String(n).padStart(2, '0');
// Siluet botol berlekuk generik (viewBox 0 0 120 360), digambar sendiri.
const BOTTLE = 'M47 6Q60 2 73 6L73 14C72 30 71 44 74 62C78 90 92 104 94 140C96 170 86 185 87 205C88 228 97 245 96 290C95 320 94 336 92 346Q90 354 80 354L40 354Q30 354 28 346C26 336 25 320 24 290C23 245 32 228 33 205C34 185 24 170 26 140C28 104 42 90 46 62C49 44 48 30 47 14Z';
---
<section id="produk" class="pr" aria-labelledby="judul-produk">
  <header class="pr-head grain">
    <div class="pr-head-bg" aria-hidden="true">
      <Image src={fotoGelembung} alt="" widths={[640, 1200, 1800]} sizes="100vw" loading="lazy" />
    </div>
    <div class="container pr-head-inner">
      <p class="eyebrow" data-pr-reveal>02 · Produk &amp; Varian</p>
      <h2 id="judul-produk" class="display-xl pr-title" data-pr-reveal>
        <span class="sr-only">Produk &amp; Varian: </span>Empat <span class="serif">karakter</span>
      </h2>
      <p class="lead pr-intro" data-pr-reveal>Beberapa varian yang umum dikenal. Ketersediaan, kemasan, dan komposisi bisa berbeda di tiap negara, jadi selalu cek label kemasan.</p>
      <ol class="pr-index" aria-label="Daftar varian">
        {products.map((p, i) => (<li><a href={`#varian-${p.id}`}><span aria-hidden="true">{pad(i + 1)}</span> {p.word}</a></li>))}
      </ol>
    </div>
  </header>

  <ul class="pr-list">
    {products.map((p, i) => (
      <li class={`pr-slide pr-${p.id}`} id={`varian-${p.id}`} data-pr-slide>
        <article class="pr-inner container" aria-labelledby={`h-${p.id}`} data-pr-inner>
          <div class="pr-copy">
            <p class="pr-num" aria-hidden="true">{pad(i + 1)} <span>/ {pad(products.length)}</span></p>
            <h3 id={`h-${p.id}`} class="pr-name" data-pr-name>
              <span class="pr-brand">{p.brand}</span>
              <span class="pr-word">{p.word.includes(' / ')
                ? (<Fragment>{p.word.split(' / ')[0]} <span class="pr-alt"><span class="serif">/</span> {p.word.split(' / ')[1]}</span></Fragment>)
                : p.word}</span>
            </h3>
            <p class="pr-desc">{p.desc}</p>
            <ul class="pr-pts">{p.pts.map((x) => <li>{x}</li>)}</ul>
          </div>
          <div class="pr-art" data-pr-art>
            <div class="pr-glow" aria-hidden="true"></div>
            <svg class="pr-bottle" viewBox="0 0 120 360" role="img" aria-label={`Ilustrasi botol ${p.name} (gambar buatan sendiri, bukan kemasan resmi)`} data-pr-bottle>
              <defs>
                <clipPath id={`clip-${p.id}`}><path d={BOTTLE} /></clipPath>
                <linearGradient id={`liq-${p.id}`} x1="0" x2="1" y1="0" y2="0">
                  <stop offset="0" stop-color="#1a0805" />
                  <stop offset=".45" stop-color="#4a1a0e" />
                  <stop offset="1" stop-color="#120503" />
                </linearGradient>
                <linearGradient id={`shade-${p.id}`} x1="0" x2="1" y1="0" y2="0">
                  <stop offset="0" stop-color="#000" stop-opacity=".45" />
                  <stop offset=".3" stop-color="#000" stop-opacity="0" />
                  <stop offset=".75" stop-color="#000" stop-opacity="0" />
                  <stop offset="1" stop-color="#000" stop-opacity=".5" />
                </linearGradient>
              </defs>
              <g clip-path={`url(#clip-${p.id})`}>
                <rect x="0" y="0" width="120" height="360" fill="rgba(255,255,255,.10)" />
                <rect x="0" y="58" width="120" height="302" fill={`url(#liq-${p.id})`} />
                <rect x="0" y="150" width="120" height="58" fill={p.label} />
                <path d="M0 186C22 168 40 196 62 180S100 166 120 176L120 186C100 178 84 192 62 192S22 180 0 198Z" fill={p.ribbon} />
                <rect x="0" y="0" width="120" height="360" fill={`url(#shade-${p.id})`} />
                <path d="M38 70C33 100 31 120 33 150" stroke="#fff" stroke-opacity=".35" stroke-width="4" fill="none" stroke-linecap="round" />
                <path d="M33 224C30 250 30 290 33 330" stroke="#fff" stroke-opacity=".28" stroke-width="5" fill="none" stroke-linecap="round" />
              </g>
              <path d={BOTTLE} fill="none" stroke="rgba(255,255,255,.35)" stroke-width="1.2" />
              <rect x="45" y="0" width="30" height="13" rx="3" fill={p.cap} stroke="rgba(0,0,0,.25)" />
            </svg>
          </div>
        </article>
      </li>
    ))}
  </ul>
</section>

<style>
  .pr { background: var(--c-ink); overflow-x: clip; }

  /* ---------- Header ---------- */
  .pr-head { position: relative; overflow: hidden; padding-block: clamp(96px, 14vw, 200px) clamp(56px, 8vw, 104px); }
  .pr-head-bg { position: absolute; inset: 0; z-index: 0; }
  .pr-head-bg :global(img) { width: 100%; height: 100%; object-fit: cover; opacity: .38; filter: saturate(1.1); }
  .pr-head-bg::after {
    content: ""; position: absolute; inset: 0;
    background: linear-gradient(180deg, var(--c-ink) 0%, rgba(10,10,11,.55) 40%, rgba(10,10,11,.7) 75%, var(--c-ink) 100%);
  }
  .pr-head-inner { position: relative; z-index: 2; }
  .pr-title { margin: .1em 0 .3em; }
  .pr-title .serif { font-size: .62em; color: var(--c-red); }
  .pr-intro { max-width: 36rem; color: var(--c-cream); }
  .pr-index { list-style: none; margin: clamp(32px, 5vw, 56px) 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: .5rem; }
  .pr-index a {
    display: inline-flex; align-items: center; gap: .5rem; min-height: 44px; padding: .5rem 1.1rem;
    border: 1px solid rgba(245,239,230,.3); border-radius: 999px;
    font-weight: 700; font-size: .9rem; text-decoration: none; color: var(--c-cream);
    transition: background-color .3s var(--ease), border-color .3s var(--ease);
  }
  .pr-index a span { color: var(--c-muted); font-size: .75rem; letter-spacing: .1em; }
  .pr-index a:hover { background: rgba(245,239,230,.08); border-color: var(--c-cream); }

  /* ---------- Slide per varian ---------- */
  .pr-list { list-style: none; margin: 0; padding: 0; }
  .pr-slide { position: relative; overflow: hidden; scroll-margin-top: var(--header-h); }
  .pr-inner {
    display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.5rem;
    padding-block: clamp(64px, 10vw, 120px);
    position: relative; z-index: 1;
  }
  .pr-num { font-weight: 800; letter-spacing: .2em; font-size: .8rem; margin: 0 0 1rem; }
  .pr-num span { font-weight: 500; }
  .pr-name { margin: 0 0 1.25rem; }
  .pr-brand { display: block; font-family: var(--font-body); font-weight: 800; font-size: clamp(.95rem, .9rem + .3vw, 1.15rem); letter-spacing: .18em; text-transform: uppercase; margin-bottom: .35em; }
  .pr-word {
    display: block; font-family: var(--font-display); font-weight: 400; text-transform: uppercase;
    font-size: clamp(3.5rem, 15vw, 11rem); line-height: .86; letter-spacing: -.005em;
  }
  .pr-zero .pr-word, .pr-light .pr-word { font-size: clamp(3rem, 13vw, 9.5rem); }
  .pr-alt { display: block; font-size: .62em; margin-top: .08em; }
  .pr-alt .serif { font-size: .8em; text-transform: none; color: #A30008; }
  .pr-desc { font-size: clamp(1.1rem, 1rem + .45vw, 1.35rem); line-height: 1.5; max-width: 32rem; margin: 0 0 1.5rem; }
  .pr-pts { list-style: none; margin: 0; padding: 0; max-width: 32rem; border-top: 1px solid currentColor; border-color: var(--line); }
  .pr-pts li { padding: .8rem 0; border-bottom: 1px solid var(--line); font-size: .98rem; display: flex; gap: .75rem; align-items: baseline; }
  .pr-pts li::before { content: ""; flex: none; width: 8px; height: 8px; border-radius: 50%; background: var(--dot); transform: translateY(-1px); }

  .pr-art { position: relative; display: grid; place-items: center; min-height: 340px; }
  .pr-glow { position: absolute; width: min(90%, 520px); aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle, var(--glow) 0%, transparent 65%); }
  .pr-bottle { position: relative; width: auto; height: clamp(300px, 62vw, 560px); filter: drop-shadow(0 30px 40px rgba(0,0,0,.45)); }

  /* Warna identitas (kontras teks kecil >= 4.5:1 terhadap latar terang-terangnya) */
  .pr-original { background: linear-gradient(150deg, #D6000A 0%, #B00008 55%, #8E0010 100%); color: #fff; --line: rgba(255,255,255,.3); --dot: #fff; --glow: rgba(255,120,110,.45); }
  .pr-zero { background: radial-gradient(70% 60% at 75% 50%, #1f1f22 0%, #0A0A0B 70%); color: var(--c-cream); --line: rgba(245,239,230,.16); --dot: var(--c-red); --glow: rgba(244,0,9,.35); }
  .pr-zero .pr-word { color: var(--c-cream); }
  .pr-zero .pr-brand, .pr-zero .pr-num { color: #ff4d55; }
  .pr-light { background: linear-gradient(150deg, #E4E6E9 0%, #C9CDD2 55%, #A9AEB4 100%); color: #0A0A0B; --line: rgba(10,10,11,.2); --dot: #B00008; --glow: rgba(255,255,255,.85); }
  .pr-light .pr-brand, .pr-light .pr-num { color: #A30008; }
  .pr-cherry { background: linear-gradient(150deg, #5C0012 0%, #3D000C 60%, #22000A 100%); color: var(--c-cream); --line: rgba(245,239,230,.2); --dot: #ff6b7a; --glow: rgba(255,60,90,.35); }
  .pr-cherry .pr-brand, .pr-cherry .pr-num { color: #ffb3bd; }

  @media (min-width: 900px) {
    .pr-inner { grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); align-items: center; min-height: 100vh; min-height: 100svh; }
    .pr-slide:nth-child(even) .pr-copy { order: 2; }
    .pr-art { min-height: 520px; }
    .pr-bottle { height: min(72vh, 620px); }
  }
  /* Efek tumpuk ala halaman produk: tiap varian menempel lalu tertutup varian berikutnya (CSS saja).
     Hanya bila layar cukup tinggi agar isi slide tidak terpotong. */
  @media (min-width: 900px) and (min-height: 700px) {
    .pr-slide { position: sticky; top: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pr-slide { position: relative; }
  }
</style>

<script>
  import '../scripts/sections/products';
</script>
