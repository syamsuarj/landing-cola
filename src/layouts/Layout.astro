---
import '../styles/global.css';
import loraWoff2 from '@fontsource-variable/lora/files/lora-latin-wght-normal.woff2?url';
import montserratWoff2 from '@fontsource-variable/montserrat/files/montserrat-latin-wght-normal.woff2?url';
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07150E" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={loraWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={montserratWoff2} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <!--
      html.js     : JS aktif (komponen boleh menyembunyikan elemen untuk animasi HANYA di bawah class ini)
      html.motion : JS aktif + tidak prefers-reduced-motion (pin/scrub hero hanya di bawah class ini)
      Pengaman: bila animations.ts gagal (tidak memasang html.hero-ready dalam 3 dtk), .motion dicabut agar konten tampil statis.
    -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          d.classList.add('motion');
          setTimeout(function () { if (!d.classList.contains('hero-ready')) d.classList.remove('motion'); }, 3000);
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#utama">Lewati ke konten utama</a>
    <slot />
  </body>
</html>
